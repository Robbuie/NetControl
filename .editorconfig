root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# --- Language conventions -------------------------------------------------
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent

csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# --- Naming ---------------------------------------------------------------
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Analyzer severities --------------------------------------------------
# Platform compatibility: this is a Windows-only tool and we P/Invoke deliberately,
# but we still want to be told where, so annotations stay accurate.
dotnet_diagnostic.CA1416.severity = warning

# Unused parameters/values in protocol parsers are often deliberate (reserved fields).
dotnet_diagnostic.IDE0060.severity = suggestion

# "Use LibraryImport instead of DllImport". The source generator emits unsafe code, which would
# mean turning on AllowUnsafeBlocks across the whole engine for the single P/Invoke we make
# (GetExtendedUdpTable). Not worth it; revisit if the native surface ever grows.
dotnet_diagnostic.SYSLIB1054.severity = suggestion

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
