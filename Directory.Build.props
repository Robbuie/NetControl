<Project>

  <!-- Shared settings for every project in the repo. Individual .csproj files
       should only carry what is genuinely specific to them. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The version, in one place.

         It is in the record, not just on the About box: every project file gets an event row
         naming the build that opened it, and the diagnostic log starts with the same string. Once
         a bug has been found and fixed, "which version wrote this file" is the question, and a
         commissioning record that cannot answer it is a record somebody has to re-do by hand.

         A release build should also pass the commit, which the SDK appends to
         AssemblyInformationalVersion as +<id>:

             pwsh tools/publish.ps1        (it passes the short commit for you)

         1.0.0 is reserved, deliberately: it is the build that commissions a real panel without the
         Rockwell tool, which is Phase 1's own definition of done. Nothing before that has earned
         the number. -->
    <VersionPrefix>0.8.0</VersionPrefix>
    <Product>NetControl</Product>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- TreatWarningsAsErrors is decided in Directory.Build.targets, not here.
       This file is imported BEFORE the project body, so $(IsSpike) is not set yet
       and any condition on it would silently evaluate against an empty string. -->

</Project>
