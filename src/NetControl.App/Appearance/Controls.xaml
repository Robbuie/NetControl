<!--
  Controls.xaml - the chrome, written entirely in tokens.

  This is the counterpart to the _QSS block in the DWG viewer's theme.py and to app.css in the
  Redline PDF app. Everything that is a colour, a radius, a font or a height comes from the token
  dictionary through {DynamicResource}; nothing below may contain a literal grey or a literal
  accent-looking colour. A hardcoded value is a spot that silently stops following the theme, and
  those are only ever found by somebody switching to the light theme and seeing one panel stay
  black. ThemeTests fails the build on a literal here - the one exception it allows is #ffffff,
  the text on the accent-filled primary button, which stays white whatever the accent is because
  the fill is always dark enough to carry it.

  {DynamicResource} rather than {StaticResource} throughout, and that is not a style preference:
  static lookups are resolved once at load and would leave every window that is already open
  showing the previous theme. The live preview in the appearance dialog depends on this.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===================================================================== -->
  <!--  Base text                                                            -->
  <!-- ===================================================================== -->

  <!-- NO FOREGROUND SETTER HERE, AND THAT IS THE WHOLE POINT OF THIS COMMENT.
       Every string put on a button, a tab, a menu row or a list cell is rendered by a TextBlock
       that a ContentPresenter makes, and a Foreground set by this style would beat the one
       inherited from the control - so a disabled button would keep full-strength text, a
       background tab would look selected and a greyed menu item would not look greyed. Colour
       comes down the tree from the window and from each control's own state; this style only
       says what the type and the rendering mode are. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- A MAC, an IP or a serial. Fixed width so a column of them lines up and a transposed pair
       of digits is visible as a bump rather than having to be read. -->
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource mono}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Secondary information: counts, paths, the version. Never a warning and never an error;
       those have their own colours. -->
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource small-font}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- The section heading from the PDF app's dialogs: small, spaced, muted - a label that
       organises without competing with what it is labelling. -->
  <Style x:Key="PanelHead" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource small-font}" />
    <Setter Property="FontWeight" Value="DemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- A panel's own name: the same size as body text, one weight up. -->
  <Style x:Key="PanelTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
  </Style>

  <!-- ===================================================================== -->
  <!--  Tooltips                                                             -->
  <!--                                                                       -->
  <!--  This app explains itself in tooltips more than most - half the        -->
  <!--  reasoning in the interface bar lives in one - so they are wrapped     -->
  <!--  and given a sane maximum width rather than running off the screen.    -->
  <!-- ===================================================================== -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource bg-2}"
                  BorderBrush="{DynamicResource line}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource corner-sm}"
                  Padding="8,6"
                  TextElement.Foreground="{DynamicResource txt-0}">
            <!-- Half the reasoning in this app lives in a tooltip, and a paragraph of it running
                 off the right of the screen would be worse than no tooltip. There is no inherited
                 wrapping property to set on the border - TextWrapping is a plain property, not an
                 attached one - so the string content gets a template that makes the TextBlock
                 itself instead. A tooltip whose content is not a string is untouched by this. -->
            <ContentPresenter>
              <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type sys:String}">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Menus                                                                -->
  <!-- ===================================================================== -->

  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource bg-1}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Padding" Value="4,2" />
    <!-- Templated from the property rather than hardcoded, because the plan toolbar uses a Menu
         as a dropdown button in the middle of a row of controls, and a rule under that one would
         be a line across the middle of the toolbar. -->
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Menu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="TopLevelMenuItem" TargetType="MenuItem">
    <Border x:Name="chrome" Background="Transparent" CornerRadius="{DynamicResource corner-sm}"
            Padding="10,5">
      <Grid>
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
               IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
               PopupAnimation="None" VerticalOffset="4">
          <Border Background="{DynamicResource bg-2}"
                  BorderBrush="{DynamicResource bg-4}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource corner}"
                  Padding="5">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
        <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
        <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- A row in a dropdown. The 22px gutter on the left is the tick column: a checkable item and
       a plain one on the same menu have to line up, or the menu looks like two menus. -->
  <ControlTemplate x:Key="SubmenuItem" TargetType="MenuItem">
    <Border x:Name="chrome" Background="Transparent" CornerRadius="{DynamicResource corner-sm}"
            Padding="0">
      <Grid Height="{DynamicResource tbtn-h}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Path x:Name="tick" Grid.Column="0"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed"
              Stretch="Uniform" Width="10"
              Fill="{DynamicResource accent-on-chrome}"
              Data="M0,5 L4,9 L11,0 L9.5,-1.2 L4,6.2 L1.3,3.6 Z" />

        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                          VerticalAlignment="Center" Margin="0,0,26,0" />

        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource txt-2}"
                   FontSize="{DynamicResource small-font}"
                   Text="{TemplateBinding InputGestureText}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
        <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="tick" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- A row that opens a further menu. Same as above plus the arrow and the nested popup. -->
  <ControlTemplate x:Key="SubmenuHeader" TargetType="MenuItem">
    <Border x:Name="chrome" Background="Transparent" CornerRadius="{DynamicResource corner-sm}">
      <Grid Height="{DynamicResource tbtn-h}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                          VerticalAlignment="Center" Margin="0,0,26,0" />

        <Path Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
              Margin="0,0,10,0" Width="4" Stretch="Uniform"
              Fill="{DynamicResource txt-2}"
              Data="M0,0 L4,4 L0,8 Z" />

        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
               IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
               PopupAnimation="None" HorizontalOffset="2">
          <Border Background="{DynamicResource bg-2}"
                  BorderBrush="{DynamicResource bg-4}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource corner}"
                  Padding="5">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
        <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource SubmenuItem}" />
    <Style.Triggers>
      <!-- Role is how WPF says which of the four shapes a MenuItem is in right now, and each
           one genuinely needs a different template - a top-level item has no tick gutter and a
           submenu header has an arrow. -->
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource TopLevelMenuItem}" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelItem">
        <Setter Property="Template" Value="{StaticResource TopLevelMenuItem}" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource SubmenuHeader}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="HorizontalRule" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,5" Background="{DynamicResource line-soft}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator" BasedOn="{StaticResource HorizontalRule}" />

  <!-- A menu looks its separators up by this key and never by type, so the implicit style above
       does not reach them and the rules in every dropdown would be the system's. -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
         BasedOn="{StaticResource HorizontalRule}" />

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource bg-2}"
                  BorderBrush="{DynamicResource bg-4}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource corner}"
                  Padding="5">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Buttons                                                              -->
  <!--                                                                       -->
  <!--  The default is the PDF app's ghost button: quiet, and it stays quiet  -->
  <!--  when there are six of them in a row - which is exactly what the plan  -->
  <!--  toolbar is.                                                          -->
  <!-- ===================================================================== -->

  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource bg-2}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="MinHeight" Value="{DynamicResource field-h}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource corner-sm}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-4}" />
            </Trigger>
            <!-- Keyboard focus is not the same state as hover, and it has to be visible on its
                 own: half the actions in this window are reached with Tab on a laptop with no
                 mouse plugged in. The hairline is the accent; the fill stays as it was. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent-line}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-1}" />
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource line-soft}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The accent-filled confirming action. One per dialog at most: a window with three of these
       has no primary action, it has three shouting buttons. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource accent-fill}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <!-- The one literal in this file. The accent fill is dark enough to carry white text at
         every one of the six accents, and a token here would make the label track the chrome
         instead of the fill it actually sits on. -->
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="chrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource corner-sm}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-lift}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-dim}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive, and it earns an outline rather than a fill it would share with the primary
       button. In this app that is anything that writes to a device or resets one. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource bad}" />
    <Setter Property="BorderBrush" Value="{DynamicResource bad}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================================================================== -->
  <!--  Check boxes                                                          -->
  <!--                                                                       -->
  <!--  Arm serve, Allow reset if needed, Only devices not in the plan. Two   -->
  <!--  of those three authorise something that touches live hardware, so the -->
  <!--  checked state is the accent at full strength and not a hint.          -->
  <!-- ===================================================================== -->

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource bg-2}"
                    BorderBrush="{DynamicResource bg-4}"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <Path x:Name="tick" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stretch="Uniform" Width="9"
                    Fill="#ffffff"
                    Data="M0,5 L4,9 L11,0 L9.5,-1.2 L4,6.2 L1.3,3.6 Z" />
            </Border>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource accent}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource accent}" />
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource accent-line}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
              <Setter TargetName="box" Property="Background" Value="{DynamicResource bg-1}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource line}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Text fields                                                          -->
  <!-- ===================================================================== -->

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource bg-2}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="CaretBrush" Value="{DynamicResource txt-0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="SelectionBrush" Value="{DynamicResource accent}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource corner-sm}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-1}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Combo box                                                            -->
  <!--                                                                       -->
  <!--  The adapter picker is the most important control in the window: it    -->
  <!--  decides which wire the tool listens on, and its items are two lines   -->
  <!--  each. So the popup is templated rather than left to the system.       -->
  <!-- ===================================================================== -->

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="chrome" Background="Transparent"
                  CornerRadius="{DynamicResource corner-sm}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-soft}" />
              <Setter Property="Foreground" Value="{DynamicResource accent-on-chrome}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource bg-2}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="MinHeight" Value="{DynamicResource field-h}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource corner-sm}" />

            <!-- The whole field is the button. A separate drop-down square is Win32 furniture
                 and it makes the field look shorter than it is. -->
            <ToggleButton Background="Transparent" BorderThickness="0"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="selected"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,9,0" Width="8" Stretch="Uniform"
                  IsHitTestVisible="False"
                  Fill="{DynamicResource txt-2}"
                  Data="M0,0 L8,0 L4,5 Z" />

            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" PopupAnimation="None" VerticalOffset="3">
              <Border MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource bg-2}"
                      BorderBrush="{DynamicResource bg-4}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource corner-sm}"
                      Padding="3">
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource bg-4}" />
              <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource txt-1}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-1}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Scroll bars                                                          -->
  <!--                                                                       -->
  <!--  12px with a 3px transparent gutter, matching the PDF app's           -->
  <!--  background-clip: content-box trick. No arrow buttons: they are four   -->
  <!--  pixels of target nobody has aimed at since the wheel mouse.           -->
  <!-- ===================================================================== -->

  <Style x:Key="ScrollBarThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="bar" Margin="3" CornerRadius="3"
                  Background="{DynamicResource bg-4}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource txt-2}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource txt-1}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The track either side of the thumb. Transparent and templated to nothing, because the
       default RepeatButton chrome would otherwise paint a grey channel down the panel. -->
  <Style x:Key="ScrollBarTrackPiece" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollBarTrackPiece}"
                              Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBarThumb}" MinHeight="28" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollBarTrackPiece}"
                              Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackPiece}"
                                  Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" MinWidth="28" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarTrackPiece}"
                                  Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================================================================== -->
  <!--  Column headers                                                       -->
  <!--                                                                       -->
  <!--  One look for both grids. The plan is a DataGrid because it is edited  -->
  <!--  in place and the two logs are ListViews because they are not, but a   -->
  <!--  person reading the window does not care and must not be able to tell. -->
  <!-- ===================================================================== -->

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource bg-1}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource small-font}" />
    <Setter Property="FontWeight" Value="DemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border x:Name="chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="0,0,1,1"
                    MinHeight="{DynamicResource grid-row-h}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <!-- Found by name, like the DataGrid's pair. Without it the log's columns silently
                 stop being draggable, which is a thing somebody notices once and works around
                 forever. -->
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                   Width="6" Cursor="SizeWE" Opacity="0" Background="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource bg-1}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource small-font}" />
    <Setter Property="FontWeight" Value="DemiBold" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="0,0,1,1"
                    MinHeight="{DynamicResource grid-row-h}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <!-- Named parts: DataGrid finds these by name to drive column resizing. Drop them
                 and the columns silently stop being draggable. -->
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                   Width="6" Cursor="SizeWE" Opacity="0" Background="Transparent" />
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                   Width="6" Cursor="SizeWE" Opacity="0" Background="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  The plan grid                                                        -->
  <!--                                                                       -->
  <!--  Horizontal rules only. A full grid of lines competes with the row     -->
  <!--  tints, and the tints are what carry the state.                       -->
  <!-- ===================================================================== -->

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource bg-2}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource line-soft}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource line-soft}" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="Transparent" />
    <Setter Property="RowHeight" Value="{DynamicResource grid-row-h}" />
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <!-- Cells and nothing else. The plan grid has no row headers and no row details -
               HeadersVisibility is Column and RowHeaderWidth is 0 - so the stock six-part
               template would be five parts that never render and one that does. -->
          <Border x:Name="chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1"
                  SnapsToDevicePixels="True">
            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- Hover before selection, so the row under the pointer lifts without pretending
                 to be the selected one. The state tints are set by the view's own triggers and
                 win over both, which is the point: a red row stays red while you hover it. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-soft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border x:Name="chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- The cell being edited is the one thing in the grid allowed to draw a box, and
                 it gets the accent hairline that every focused field in the app gets. -->
            <Trigger Property="IsEditing" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-2}" />
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent}" />
              <Setter TargetName="chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="chrome" Property="Padding" Value="7,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  The two logs                                                         -->
  <!-- ===================================================================== -->

  <Style TargetType="ListView">
    <Setter Property="Background" Value="{DynamicResource bg-2}" />
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="{DynamicResource grid-row-h}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <GridViewRowPresenter VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-soft}" />
              <Setter Property="Foreground" Value="{DynamicResource accent-on-chrome}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Tabs                                                                 -->
  <!-- ===================================================================== -->

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource line}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" Margin="0,0,0,-1" />
            </Border>
            <Border Background="Transparent">
              <ContentPresenter ContentSource="SelectedContent" />
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The selected tab is marked with an accent underline rather than a raised folder tab.
       Two tabs that mean different things - one is devices asking, one is devices already
       addressed - want a mark that says which, not chrome that says "tabs". -->
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
    <Setter Property="FontFamily" Value="{DynamicResource font}" />
    <Setter Property="FontSize" Value="{DynamicResource ui-font}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="chrome" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2"
                  Padding="14,7">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent}" />
              <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Splitter                                                             -->
  <!-- ===================================================================== -->

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="Transparent">
            <Border x:Name="bar" Height="1" VerticalAlignment="Center"
                    Background="{DynamicResource line}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource accent-line}" />
              <Setter TargetName="bar" Property="Height" Value="3" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource accent}" />
              <Setter TargetName="bar" Property="Height" Value="3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== -->
  <!--  Named panel pieces                                                   -->
  <!--                                                                       -->
  <!--  The equivalent of the object names at the bottom of theme.py. A view  -->
  <!--  that needs something not here should add it here, because a local     -->
  <!--  brush is a grey that will be wrong in four of the five themes.        -->
  <!-- ===================================================================== -->

  <!-- A notice that needs a person but has not stopped anything. -->
  <Style x:Key="WarningNotice" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource notice-warn}" />
    <Setter Property="BorderBrush" Value="{DynamicResource warn}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource corner-sm}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- A notice about something that did stop. Red is reserved for exactly this. -->
  <Style x:Key="FaultNotice" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource notice-bad}" />
    <Setter Property="BorderBrush" Value="{DynamicResource bad}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource corner-sm}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style x:Key="WarningText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource warn}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FaultText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource bad}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Muted, but amber - the status bar's "not saved to a file yet" and the update notice. -->
  <Style x:Key="MutedWarning" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="Foreground" Value="{DynamicResource warn}" />
  </Style>

  <Style x:Key="MutedFault" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="Foreground" Value="{DynamicResource bad}" />
  </Style>

  <!-- A 1px vertical rule between groups of controls in a toolbar. -->
  <Style x:Key="ToolbarSeparator" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource line}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="10,3" />
  </Style>

</ResourceDictionary>
