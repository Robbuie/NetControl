<Window x:Class="NetControl.App.Views.NetworkActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network activity and safety"
        Width="900"
        Height="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- What NetControl has put on the wire this session, and the two controls over it. The answer to
       "what did your tool just do to my network?" should be a list, not an assurance. -->

  <DockPanel Margin="18,14,18,14">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="What NetControl may send" />

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,6,0,10">
      <StackPanel>
        <CheckBox Content="Listen only - transmit nothing" FontWeight="SemiBold"
                  IsChecked="{Binding IsListenOnly}"
                  ToolTip="Scans, pings, Set static, DHCP replies, TFTP refusals and PROFINET frames are all refused. Watching and Passive listening carry on." />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,2,0,8"
                   Text="Use it on a running line: the tool can watch, listen and read this PC's own state, and cannot disturb anything. Remembered when NetControl restarts." />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Send no more than" VerticalAlignment="Center" />
          <TextBox Width="60" Margin="6,0,6,0" VerticalAlignment="Center"
                   Text="{Binding MaxPacketsPerSecondText, UpdateSourceTrigger=LostFocus}"
                   ToolTip="Every feature together. 0 removes the cap; anything under 10 is raised to 10." />
          <TextBlock Text="packets a second, across every feature together (0 for no cap)." VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Each feature keeps its own gentle limits; this is the backstop when two run at once. Over the cap, sending waits rather than failing - a scan takes longer, nothing is lost." />
      </StackPanel>
    </Border>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBox x:Name="FilterBox" Width="160" VerticalAlignment="Center" TextChanged="OnFilterChanged"
                 ToolTip="Show only rows whose destination, kind or purpose contains this." />
        <CheckBox x:Name="BlockedOnly" Content="Blocked only" Margin="8,0,0,0" VerticalAlignment="Center"
                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
      </StackPanel>
      <TextBlock x:Name="TotalsText" Style="{StaticResource PanelHead}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Export CSV..." MinWidth="100" Margin="0,0,8,0" Click="OnExport" />
      <Button Content="Clear list" MinWidth="80" Margin="0,0,8,0" Click="OnClear"
              ToolTip="Empties this list. The totals keep counting." />
      <Button Content="Close" IsCancel="True" MinWidth="80" Click="OnClose" />
    </StackPanel>

    <DataGrid x:Name="Packets"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
              VirtualizingPanel.IsVirtualizing="True">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Blocked}" Value="True">
              <Setter Property="Background" Value="{DynamicResource row-warn}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="When" Width="100" Binding="{Binding When, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
        <DataGridTextColumn Header="What" Width="110" Binding="{Binding Kind, Mode=OneWay}" />
        <DataGridTextColumn Header="To" Width="170" Binding="{Binding Destination, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
        <DataGridTextColumn Header="Why" Width="*" Binding="{Binding Purpose, Mode=OneWay}" />
        <DataGridTextColumn Header="Bytes" Width="60" Binding="{Binding Bytes, Mode=OneWay}" />
        <DataGridTextColumn Header="" Width="70" Binding="{Binding State, Mode=OneWay}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
