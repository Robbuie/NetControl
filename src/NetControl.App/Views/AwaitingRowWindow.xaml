<Window x:Class="NetControl.App.Views.AwaitingRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign to awaiting plan row"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- The device that asked is one of the rows imported without a MAC: pick which, and its MAC is
       written onto that row (PLAN-IMPORT.md F3). Nothing is sent from here. -->

  <StackPanel Margin="18,14,18,14">
    <TextBlock x:Name="DeviceText" Style="{StaticResource PanelHead}" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"
               Text="Pick the plan row this device is. Its MAC is written onto that row; nothing is sent. Check it against the label - a wrong row hands that row's address to this device." />

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Filter" Style="{StaticResource PanelHead}" VerticalAlignment="Center" Margin="0,0,14,0" />
      <TextBox Grid.Column="1" x:Name="FilterBox" TextChanged="OnFilterChanged" />
    </Grid>

    <ListView x:Name="RowList" Height="280" SelectionMode="Single" MouseDoubleClick="OnRowDoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Device" Width="200" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="Planned IP" Width="120" DisplayMemberBinding="{Binding Ip}" />
          <GridViewColumn Header="Where" Width="180" DisplayMemberBinding="{Binding Where}" />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Assign MAC" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80"
              Margin="0,0,8,0" Click="OnAssign" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
