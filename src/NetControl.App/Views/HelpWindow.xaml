<Window x:Class="NetControl.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetControl - User guide"
        Height="760" Width="1080"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ChromeWindow}">

  <!-- Help > User guide, or F1. The README, compiled into the exe - see HelpDocument. Not modal
       and not owned, so it can sit beside the main window while somebody follows it step by step;
       MainWindow closes it when it closes. -->

  <Window.Resources>
    <!-- A contents entry: flat until hovered, the accent tint when it is the section on show. -->
    <Style x:Key="ContentsItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSectionClicked" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip"
                    Background="Transparent"
                    CornerRadius="{DynamicResource corner-sm}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource bg-3}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource accent-soft}" />
                <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10,2,10,10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Contents and search. -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Search the guide" Style="{StaticResource PanelHead}"
                   Margin="4,2,0,4" />
        <TextBox DockPanel.Dock="Top" x:Name="SearchBox"
                 Margin="0,0,0,10"
                 TextChanged="OnSearchChanged"
                 PreviewKeyDown="OnSearchKeyDown"
                 ToolTip="Lists only the sections that mention what you type. Enter opens the first one." />

        <TextBlock DockPanel.Dock="Top" Text="Contents" Style="{StaticResource PanelHead}" Margin="4,0,0,4" />
        <TextBlock DockPanel.Dock="Top" x:Name="NoMatches"
                   Style="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Margin="4,2,4,8"
                   Visibility="Collapsed" />

        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLine"
                   Style="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Margin="4,8,4,0" />

        <ListBox x:Name="SectionList"
                 DisplayMemberPath="Title"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource ContentsItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSectionSelected" />
      </DockPanel>
    </Border>

    <!-- The guide itself. Selectable, so a netsh line or a CSV header can be copied out of it. -->
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="2">
      <FlowDocumentScrollViewer x:Name="Viewer"
                                IsToolBarVisible="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" />
    </Border>
  </Grid>
</Window>
