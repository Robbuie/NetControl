<Window x:Class="NetControl.App.Views.SetOnSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set on selected rows"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- The same value on many plan rows at once - typically the mask and gateway for a whole cell.
       A plan edit only: nothing is sent to any device. -->

  <StackPanel Margin="18,14,18,14">
    <TextBlock x:Name="HeadText" Style="{StaticResource PanelHead}" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"
               Text="Leave a box empty to keep each row's own value. This changes the plan only - nothing is sent." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Subnet mask" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaskBox" Margin="0,0,0,6" />

      <TextBlock Grid.Row="1" Text="Gateway" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="GatewayBox" Margin="0,0,0,6" />

      <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ClearGatewayBox" Margin="0,0,0,10"
                Content="Clear the gateway on these rows"
                ToolTip="For devices that must not route off their own subnet." />

      <TextBlock Grid.Row="3" Text="Panel" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="PanelBox" Margin="0,0,0,6" />

      <TextBlock Grid.Row="4" Text="Role" VerticalAlignment="Center" Margin="0,0,14,0" />
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="RoleBox" />
    </Grid>

    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource bad}"
               Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Set" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80"
              Margin="0,0,8,0" Click="OnSet" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
