<Window x:Class="NetControl.App.Views.SubnetCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subnet calculator"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- PLAN-TOOLKIT.md F6. Recalculates as it is typed into, sends nothing and stores nothing. It
       opens on the selected adapter's own subnet, because the question is nearly always "is that
       device on the same subnet as my laptop". -->

  <Grid Margin="18,16,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputBox"
             FontFamily="{DynamicResource mono}"
             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="An address and a prefix or mask: 192.168.1.51/24, or 192.168.1.51 255.255.255.0." />

    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource bad}"
               Text="{Binding Problem}"
               Visibility="{Binding Problem, Converter={StaticResource NotNullToVisible}}" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Network" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,10,14,0" />
    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource MonoText}" Text="{Binding Network}" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mask" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,6,14,0" />
    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MonoText}" Text="{Binding Mask}" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Hosts" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,6,14,0" />
    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MonoText}" Text="{Binding Hosts}" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="Usable" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,6,14,0" />
    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MonoText}" Text="{Binding HostCount}" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="Broadcast" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,6,14,0" />
    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MonoText}" Text="{Binding Broadcast}" />

    <TextBlock Grid.Row="7" Grid.Column="0" Text="Wildcard" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" Margin="0,6,14,0" />
    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource MonoText}" Text="{Binding Wildcard}" />

    <Separator Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource HorizontalRule}" Margin="0,10,0,6" />

    <TextBlock Grid.Row="9" Grid.Column="0" Text="Is this on it?" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
    <StackPanel Grid.Row="9" Grid.Column="1">
      <TextBox FontFamily="{DynamicResource mono}"
               Text="{Binding Other, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Another address - a device, a gateway - to check against the subnet above." />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding OtherVerdict}"
                 Visibility="{Binding OtherVerdict, Converter={StaticResource NotNullToVisible}}" />
    </StackPanel>

    <Button Grid.Row="10" Grid.Column="1" Content="Close" IsCancel="True" IsDefault="True"
            HorizontalAlignment="Right" MinWidth="80" Margin="0,16,0,0" Click="OnClose" />
  </Grid>
</Window>
