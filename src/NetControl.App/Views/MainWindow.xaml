<Window x:Class="NetControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetControl.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NetControl - BOOTP/DHCP"
        Height="720" Width="1180"
        MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource bg-0}"
        FontFamily="{DynamicResource font}"
        FontSize="{DynamicResource ui-font}"
        Foreground="{DynamicResource txt-0}">

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <!-- There is no Save. SQLite writes as the plan is typed, so a project can only ever be
           missing a location, never its contents - which is what Save as gives it. -->
      <MenuItem Header="_File">
        <MenuItem Header="_New project" Click="OnNewProject" />
        <MenuItem Header="_Open project..." Click="OnOpenProject" />
        <MenuItem Header="Save _as..." Click="OnSaveProjectAs"
                  ToolTip="Copies this project - plan, assignments and the whole event log - to a file, and keeps working there." />
        <Separator />
        <MenuItem Header="_Import plan from CSV..." Click="OnImportPlan"
                  ToolTip="Checks the whole file first. If anything in it is wrong, nothing is imported and every problem is listed with its line number." />
        <MenuItem Header="_Export plan to CSV..." Click="OnExportPlan"
                  ToolTip="The plan only. What was served and what was verified stay in the project's event log, which nothing can edit." />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Listener">
        <MenuItem Header="_Watch" Command="{Binding StartWatchCommand}" />
        <MenuItem Header="_Serve" Command="{Binding StartServeCommand}" />
        <MenuItem Header="Sto_p" Command="{Binding StopCommand}" />
        <Separator />
        <MenuItem Header="_Re-check port and firewall" Command="{Binding RefreshEnvironmentCommand}" />
        <Separator />
        <MenuItem Header="Reply by per-socket _bind"
                  IsCheckable="True"
                  IsChecked="{Binding UsePerSocketBind}"
                  ToolTip="Off uses IP_UNICAST_IF on the listening socket. That path has only ever been proved against a listener on this machine, so the bind is the default until real hardware says otherwise." />
      </MenuItem>
      <MenuItem Header="_View">
        <!-- Theme, accent and density. The same three axes as the DWG viewer and the Redline PDF
             app, and the same design system underneath - so a person who set one of those up the
             way they like it will find this one already familiar. -->
        <MenuItem Header="_Appearance..." Click="OnAppearance"
                  ToolTip="Theme, accent colour and how much room the chrome takes. Applied as you choose, saved when you press OK." />
      </MenuItem>
      <MenuItem Header="_Help">
        <!-- The startup check is silent unless there is a newer build. This one always answers,
             including "could not reach it", because somebody pressing it is waiting to be told. -->
        <MenuItem Header="Check for _updates" Click="OnCheckForUpdates"
                  ToolTip="Asks the repository whether a newer build has been published, and offers to download and install it. Refused while the listener is running or a device is being commissioned." />
        <MenuItem Header="_Releases page" Click="OnOpenReleases"
                  ToolTip="Opens the download page in a browser. Needs a machine with a route out - most plant laptops do not have one." />
        <Separator />
        <MenuItem Header="Open the _diagnostic log folder" Click="OnOpenLogFolder"
                  ToolTip="Why the application misbehaved. Not the commissioning record - that is the event log inside the project file, and nothing can edit it." />
        <Separator />
        <MenuItem Header="_About NetControl" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ============================ Interface bar ============================
         Always visible, and the first thing the eye lands on. "Nothing is arriving" has four
         common causes and three of them are measurable before a packet lands; this bar rules
         those three out so nobody has to guess which one they are looking at. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource chrome-fill}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <StackPanel>

        <!-- Headline: the state light, the sentence, the adapter, and the controls. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Grid.Column="0"
                   Width="14" Height="14"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Fill="{Binding InterfaceBar.Overall, Converter={StaticResource ReadinessBrush}}" />

          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="13"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding InterfaceBar.Headline}"
                     ToolTip="{Binding InterfaceBar.Headline}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,6,0" />

            <ComboBox Width="300"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding InterfaceBar.Adapters}"
                      SelectedItem="{Binding InterfaceBar.SelectedAdapter}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AdapterOption}">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Style.Triggers>
                            <!-- Dimmed, never hidden. The heuristic that calls an adapter
                                 virtual is only allowed to sort and shade, never to decide. -->
                            <DataTrigger Binding="{Binding IsLikelyVirtual}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPresent}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource bad}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}">
                      <Run Text="{Binding AddressText, Mode=OneWay}" />
                      <Run Text=" - " />
                      <Run Text="{Binding LinkText, Mode=OneWay}" />
                      <Run Text=" - " />
                      <Run Text="{Binding Description, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Serve is armed separately from being started. Two deliberate actions, because a
                 rogue DHCP server on a plant network is a genuinely serious incident. -->
            <CheckBox Content="Arm serve"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      IsChecked="{Binding IsServeArmed}"
                      IsEnabled="{Binding InterfaceBar.CanArmServeMode}"
                      ToolTip="Serve mode answers only MACs that are in the plan, and only on the selected adapter." />

            <Button Content="Watch" Command="{Binding StartWatchCommand}" />
            <Button Content="Serve" Command="{Binding StartServeCommand}" />
            <Button Content="Stop" Command="{Binding StopCommand}" />
          </StackPanel>
        </Grid>

        <!-- One graded line per precondition. Grading rather than summarising is the point: a
             wildcard bind by VMware and Hyper-V holding its own address are both "port in use",
             and showing them the same way is what trains people to ignore the warning. -->
        <ItemsControl ItemsSource="{Binding InterfaceBar.Checks}" Margin="22,8,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding Detail}">
                <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource txt-2}"
                           Text="{Binding Summary}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- "Your device is asking, but on an adapter you did not select" - the most useful
             sentence this tool can produce, so it gets its own line rather than a log row. -->
        <Border Margin="22,8,0,0" Padding="8,5"
                Background="{DynamicResource notice-warn}"
                BorderBrush="{DynamicResource warn}"
                BorderThickness="1"
                Visibility="{Binding InterfaceBar.MisdirectedTraffic, Converter={StaticResource NotNullToVisible}}">
          <TextBlock TextWrapping="Wrap"
                     Foreground="{DynamicResource warn}"
                     Text="{Binding InterfaceBar.MisdirectedTraffic}" />
        </Border>

        <Border Margin="22,8,0,0" Padding="8,5"
                Background="{DynamicResource notice-bad}"
                BorderBrush="{DynamicResource bad}"
                BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisible}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource bad}"
                       Text="{Binding ErrorMessage}" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource bad}"
                       Visibility="{Binding ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                       Text="{Binding ErrorRemediation}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>

    <!-- ============================== Status bar ============================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource bg-1}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ProjectName}"
                     ToolTip="{Binding ProjectPath}" />
          <!-- Not a dirty flag. Edits are already in the database; what is missing is a file to
               keep it in, and saying that plainly is cheaper than a Save button people look for. -->
          <TextBlock Style="{StaticResource Muted}"
                     Foreground="{DynamicResource warn}"
                     Margin="6,0,0,0"
                     Text="(not saved to a file yet)"
                     ToolTip="Nothing is lost while the app is open, but nothing survives closing it either. File, Save as."
                     Visibility="{Binding IsUnsavedLocation, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}">
            <Run Text="{Binding PlannedDeviceCount, Mode=OneWay}" />
            <Run Text=" planned" />
          </TextBlock>
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}">
            <Run Text="{Binding Log.RequestCount, Mode=OneWay}" />
            <Run Text=" requests, " />
            <Run Text="{Binding Log.ServedCount, Mode=OneWay}" />
            <Run Text=" served, " />
            <Run Text="{Binding Log.UnknownDeviceCount, Mode=OneWay}" />
            <Run Text=" unknown" />
          </TextBlock>

          <!-- Which build this is. The first question anybody asks about an exe somebody copied
               onto a laptop, and the same string the project file records - so a commissioning
               record and the tool in front of you can be matched without opening either. -->
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}"
                     Text="{Binding VersionText, Mode=OneTime}"
                     ToolTip="The build that is running. It is written into every project file this session opens." />

          <!-- Absent unless there is something to say. Every ordinary state - the check turned
               off, already on the current build, and a check that could not reach anything - is
               silence at startup, because a status bar with something in it at all times is a
               status bar nobody reads. What is left is worth clicking: this line only appears when
               a newer build exists, and clicking it is how you install it. -->
          <TextBlock Style="{StaticResource Muted}"
                     Foreground="{DynamicResource warn}"
                     Margin="10,0,0,0"
                     TextTrimming="CharacterEllipsis"
                     Cursor="Hand"
                     MouseLeftButtonUp="OnUpdateStatusClicked"
                     Text="{Binding UpdateStatus}"
                     ToolTip="Click to download and install it. Same as Help &gt; Check for updates."
                     Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding InterfaceBar.OuiSummary}"
                   Text="{Binding InterfaceBar.OuiSummary}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding InterfaceBar.OuiIsStale}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="2"
                   Foreground="{DynamicResource bad}"
                   FontWeight="SemiBold"
                   Visibility="{Binding RecordingIsIncomplete, Converter={StaticResource BoolToVisible}}"
                   Text="Event log incomplete - a row failed to write"
                   ToolTip="The listener kept serving, but the commissioning record has a hole in it. The detail is in the log." />
      </Grid>
    </Border>

    <!-- The plan above, the wire below, both visible at once. That is the working loop: you watch
         a device ask, you plan it, and it is served on its next retransmit. Tabs would hide one
         half of that from the other. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="140" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" MinHeight="120" />
      </Grid.RowDefinitions>

      <!-- ================================ Plan grid ================================
           Edits go straight into the project file as each cell is left, and straight into the
           policy the receive loop reads. There is no Save button because there is nothing to
           save - see the status bar. -->
      <DockPanel Grid.Row="0" Margin="10,8,10,0">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Plan" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center">
            <Run Text="{Binding Plan.ServableCount, Mode=OneWay}" />
            <Run Text=" of " />
            <Run Text="{Binding Plan.Rows.Count, Mode=OneWay}" />
            <Run Text=" rows complete and servable" />
          </TextBlock>
          <Button Content="Add device" Margin="16,0,0,0" Command="{Binding Plan.AddDeviceCommand}" />
          <Button Content="Remove" Command="{Binding Plan.RemoveDeviceCommand}" />

          <!-- The half of the job BOOTP does not do. An address served over BOOTP lasts until the
               next power cycle, because the device is still a BOOTP client; this writes it in and
               turns the protocol off, then reads it back off the device before saying so. -->
          <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

          <Button Content="Set static"
                  MinWidth="110"
                  Command="{Binding Plan.SetStaticCommand}"
                  ToolTip="Writes the planned address into the selected device and disables BOOTP/DHCP, then reads it back to confirm it took. Sent only to that one device." />

          <!-- Its own control, because on a running line resetting a module is an outage and
               nobody should discover they authorised one by pressing the button next to it. -->
          <CheckBox Content="Allow reset if needed"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    IsChecked="{Binding Plan.AllowDeviceReset}"
                    ToolTip="Some adapters hold a written configuration until the interface is reset. Left off, such a device is reported unverified rather than quietly restarted." />

          <!-- The reverse operation. Handing a device back to a plant DHCP server is a real job at
               the end of a commissioning - but it is also how a device stops owning its address, so
               it is chosen by name, from a menu, behind a confirmation, rather than arrived at by
               leaving a dropdown where somebody else left it. IsEnabled binds to the same rule the
               commands use; a second copy of it written here is a copy that drifts. -->
          <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                Margin="10,0,0,0" Padding="0">
            <MenuItem Header="Enable BOOTP/DHCP"
                      ToolTip="Writes Configuration Control and nothing else. The addresses the device is holding are left alone, but it stops owning them and asks for one again at its next power cycle.">
              <MenuItem Header="Enable _BOOTP on the selected device"
                        IsEnabled="{Binding Plan.CanHandBack}"
                        Click="OnEnableBootp" />
              <MenuItem Header="Enable _DHCP on the selected device"
                        IsEnabled="{Binding Plan.CanHandBack}"
                        Click="OnEnableDhcp" />
            </MenuItem>
          </Menu>

          <TextBlock Style="{StaticResource Muted}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource warn}"
                     Text="Writing to device..."
                     Visibility="{Binding Plan.IsCommissioning, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,6,0,8" Padding="8,5"
                Background="{DynamicResource notice-bad}"
                BorderBrush="{DynamicResource bad}"
                BorderThickness="1"
                Visibility="{Binding Plan.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource bad}"
                       Text="{Binding Plan.ErrorMessage}" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource bad}"
                       Visibility="{Binding Plan.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                       Text="{Binding Plan.ErrorRemediation}" />
          </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Plan.Rows}"
                  SelectedItem="{Binding Plan.SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

          <!-- The row carries its own explanation. A panel underneath would make somebody match a
               message to a line by eye, and DataGrid's own validation paints a red box with no
               sentence in it at all. Red means it was not stored; amber means it was stored and
               will not be served, which is a normal state for a plan being typed. -->
          <DataGrid.RowStyle>
            <!-- BasedOn, and it is load-bearing: an explicit RowStyle replaces the implicit one
                 rather than adding to it, so without this the grid keeps its triggers and loses
                 its template - which is to say it stops following the theme entirely. -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsServable}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource row-warn}" />
                </DataTrigger>
                <!-- Last trigger wins, so this deliberately follows the amber one. -->
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource row-bad}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource good}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServable}" Value="False">
                            <Setter Property="Fill" Value="{DynamicResource warn}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource bad}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="MAC" Width="150"
                                Binding="{Binding MacText}"
                                ElementStyle="{StaticResource MonoText}" />
            <DataGridTextColumn Header="Planned IP" Width="120" Binding="{Binding IpText}" />
            <DataGridTextColumn Header="Subnet mask" Width="120" Binding="{Binding MaskText}" />
            <DataGridTextColumn Header="Gateway" Width="120" Binding="{Binding GatewayText}" />
            <DataGridTextColumn Header="Host name" Width="130" Binding="{Binding HostName}" />
            <DataGridTextColumn Header="Panel" Width="100" Binding="{Binding PanelRef}" />
            <DataGridTextColumn Header="Role" Width="150" Binding="{Binding Role}" />

            <!-- Derived from the MAC and stored at that moment, so the file still reads correctly
                 when the IEEE registry moves on. A hand-typed vendor that disagreed with the MAC
                 would be worse than none, hence read-only. -->
            <DataGridTextColumn Header="Vendor" Width="170" IsReadOnly="True"
                                Binding="{Binding Vendor, Mode=OneWay}" />

            <DataGridTextColumn Header="State" Width="80" IsReadOnly="True"
                                Binding="{Binding State, Mode=OneWay}" />

            <DataGridTextColumn Header="Notes" Width="220" Binding="{Binding Notes}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Row="1"
                    Height="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ShowsPreview="True" />

      <!-- ============================= Live request log =============================
           Every request as it lands, with the adapter it arrived on, the vendor behind the MAC,
           and whether it matched a planned device. Newest first, so nothing has to auto-scroll. -->
      <!-- The two halves of discovery, kept apart on purpose. A device in the live log asked for
           an address; a device in the scan results already has one and did not ask for anything.
           Both feed the same "add to plan" action, and a list that conflated them would mislead. -->
      <TabControl Grid.Row="2" Margin="10,6,10,8">

        <!-- ============================ Live request log ============================
             Every request as it lands, with the adapter it arrived on, the vendor behind the MAC,
             and whether it matched a planned device. Newest first, so nothing has to auto-scroll. -->
        <TabItem Header="Live requests">
          <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <CheckBox Content="Only devices that are not in the plan"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Log.ShowOnlyUnknownDevices}" />
              <Button Content="Clear" Margin="16,0,0,0" Command="{Binding ClearLogCommand}" />
            </StackPanel>

            <ListView ItemsSource="{Binding Log.Entries}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <!-- The row menu lives here rather than inline in the Setter below, and it has to.
                   A Click handler inside a Setter.Value does compile, but the XAML compiler wires it
                   through IStyleConnector, whose connection ids only line up for EventSetters - so the
                   handler lands on whatever element is connected next (the GridView) and the build
                   fails talking about a type that has nothing to do with it. As a keyed resource it
                   goes through the ordinary component connector and behaves. -->
              <ListView.Resources>
                <ContextMenu x:Key="LogRowMenu">
                  <MenuItem Header="_Add to plan" Click="OnAddToPlan"
                            ToolTip="Adds this MAC to the plan, ready for you to type its address. Nothing is sent." />
                </ContextMenu>
              </ListView.Resources>

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the plan grid's RowStyle: an explicit
                     container style replaces the implicit one instead of extending it. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                  <!-- Watch a device ask, double-click it, and its MAC is in the plan - served on its
                       next retransmit, once you have typed an address for it. Adding a row transmits
                       nothing by itself; Serve mode still has to be armed and started separately. -->
                  <EventSetter Event="MouseDoubleClick" Handler="OnLogRowDoubleClicked" />

                  <!-- One menu instance shared by every row, so the handler resolves the row it was
                       opened on through PlacementTarget rather than through its own data context. -->
                  <Setter Property="ContextMenu" Value="{StaticResource LogRowMenu}" />

                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Outcome}" Value="Served">
                      <Setter Property="Background" Value="{DynamicResource row-good}" />
                    </DataTrigger>
                    <!-- A stranger on the network reads differently from a device you are waiting for.
                         Last trigger wins, so this deliberately follows Served. -->
                    <DataTrigger Binding="{Binding IsUnknownDevice}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-unknown}" />
                    </DataTrigger>
                    <!-- Amber, matching how the interface bar grades the same finding. Red is reserved
                         for a fault that actually stopped something. -->
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      <Setter Property="Foreground" Value="{DynamicResource warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Fault">
                      <Setter Property="Background" Value="{DynamicResource row-bad}" />
                      <Setter Property="Foreground" Value="{DynamicResource bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="92" DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn Header="Message type" Width="120" DisplayMemberBinding="{Binding Label}" />
                  <GridViewColumn Header="MAC" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding MacText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <!-- What the plan calls this device, snapshotted when the row was made. Ahead of
                       Vendor because on a bench you read this log against a printed plan, and "Conveyor
                       3 drive" finds the line quicker than a MAC or a manufacturer does. -->
                  <GridViewColumn Header="Device" Width="180" DisplayMemberBinding="{Binding NameText}" />
                  <GridViewColumn Header="Vendor" Width="190" DisplayMemberBinding="{Binding VendorText}" />
                  <GridViewColumn Header="Arrived on" Width="170" DisplayMemberBinding="{Binding AdapterText}" />
                  <GridViewColumn Header="Repeats" Width="66" DisplayMemberBinding="{Binding RepeatText}" />
                  <GridViewColumn Header="What happened" Width="460" DisplayMemberBinding="{Binding Message}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- ============================== Scan results ==============================
             Devices that already have an address, found by asking rather than by waiting. A device
             here does not need BOOTP - so the value of a scan is verification (did the device we
             served come up where we said), conflict detection (something is already on that
             address) and inventory. Pressing Scan transmits; nothing here writes to a device. -->
        <TabItem Header="Scan results">
          <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <Button Content="Scan"
                      MinWidth="90"
                      Command="{Binding ScanCommand}"
                      ToolTip="Asks every EtherNet/IP device on the selected adapter to identify itself. One broadcast on UDP/44818, nothing written to anything." />
              <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearScanCommand}" />
              <TextBlock Style="{StaticResource Muted}"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Scan.Status}" />
            </StackPanel>

            <!-- What the scan had to say about the plan.
                 Its own panel rather than only a column, because a finding is a relationship
                 between two lists - "this address is planned for that device" - and the plan row it
                 is about may not be visible anywhere on this tab. Every finding that does concern a
                 device in the list below also lands in that device's own Note, so nothing here has
                 to be matched up by eye. Confirmations and unplanned devices are not listed: they
                 are in the row notes and in the summary tally, and a panel that scrolls is one
                 whose bottom entries nobody reads. -->
            <Border DockPanel.Dock="Bottom"
                    Style="{StaticResource WarningNotice}"
                    Margin="10,0,10,8"
                    Visibility="{Binding Scan.HasFindings, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <TextBlock Text="The plan and the segment disagree"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Scan.Findings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding Scan.Rows}"
                      SelectedItem="{Binding Scan.SelectedRow}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <!-- Keyed, not inline in the Setter below, for the reason spelled out on the log's
                   own row menu: a Click handler inside a Setter.Value is wired through
                   IStyleConnector and lands on the wrong element. -->
              <ListView.Resources>
                <ContextMenu x:Key="ScanRowMenu">
                  <MenuItem Header="_Add to plan" Click="OnAddScanResultToPlan"
                            ToolTip="Adds this device to the plan at the address it is already holding. Nothing is sent." />
                </ContextMenu>
              </ListView.Resources>

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the plan grid's RowStyle: an explicit
                     container style replaces the implicit one instead of extending it. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <EventSetter Event="MouseDoubleClick" Handler="OnScanRowDoubleClicked" />
                  <Setter Property="ContextMenu" Value="{StaticResource ScanRowMenu}" />

                  <Style.Triggers>
                    <!-- Amber for a row that needs a person: a MAC that could not be resolved, or
                         two devices on one address. Last trigger wins, so "already planned" sits
                         after it - a device you have dealt with reads as dealt with. -->
                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAlreadyPlanned}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-good}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Address" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding AddressText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Product" Width="230" DisplayMemberBinding="{Binding ProductText}" />
                  <GridViewColumn Header="Rev" Width="56" DisplayMemberBinding="{Binding RevisionText}" />
                  <GridViewColumn Header="Serial" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SerialText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="MAC" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding MacText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Vendor" Width="190" DisplayMemberBinding="{Binding VendorText}" />
                  <GridViewColumn Header="Note" Width="420" DisplayMemberBinding="{Binding Note}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- ============================== TFTP backup ==============================
             PLAN-TFTP.md parts E1, E3 and E5. A FANUC image backup over Ethernet is a BOOTP request
             followed by a TFTP write request, and when it "never starts" nobody can say which half
             broke. This tab watches the second half and, together with the BOOTP listener at the top
             of the window, says which step the backup stopped at. Watching refuses every request on
             purpose: it records what the controller asked for and never receives the image. -->
        <TabItem Header="TFTP backup">
          <DockPanel>

            <!-- Where this PC stands, then the watch. The vantage tick changes how UDP/69 is graded:
                 on the backup server, nothing holding the port is the fault; on a laptop it is what
                 lets the watch bind. -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <CheckBox Content="This PC is the backup server"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        IsChecked="{Binding Tftp.IsBackupServer}"
                        ToolTip="Tick on the PC the robots back up to. Leave clear on a laptop plugged into the robot network." />

              <TextBlock Text="Backup folder" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Width="240"
                       VerticalAlignment="Center"
                       Text="{Binding Tftp.RootFolder, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The TFTP server's root folder. Checked by writing a small probe file into it and deleting it again." />
              <Button Content="Browse..." Margin="6,0,0,0" Click="OnBrowseTftpRoot" />
              <Button Content="Check folder" Command="{Binding Tftp.CheckRootCommand}" />

              <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

              <!-- Armed separately from being started, like Serve: a refusal is a transmission. -->
              <CheckBox Content="Arm"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        IsChecked="{Binding Tftp.IsWatchArmed}"
                        ToolTip="The watch answers each request with a refusal, on the adapter selected at the top of the window only. Stop the real TFTP server first - the watch will not share UDP/69 with it." />
              <Button Content="Watch TFTP" Command="{Binding Tftp.StartWatchCommand}" />
              <Button Content="Stop" Command="{Binding Tftp.StopWatchCommand}" />
              <Button Content="Re-check" Command="{Binding Tftp.RefreshCommand}"
                      ToolTip="Who holds UDP/69 on this PC, whether the firewall lets it in, and the backup folder." />
              <Button Content="Clear" Command="{Binding Tftp.ClearCommand}"
                      ToolTip="Empties the list and starts the verdict over, for the next attempt." />
            </WrapPanel>

            <!-- This PC, graded the way the interface bar grades UDP/67 - but on its own row, because
                 the same fact (a TFTP server holding the port) is good news here and bad news there. -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tftp.Checks}" Margin="12,0,10,6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding Detail}">
                    <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource txt-2}"
                               Text="{Binding Summary}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The verdict. One line per step, each grey until it has actually been seen, and above
                 them the one sentence that names the earliest step not known to have worked. -->
            <Border DockPanel.Dock="Top"
                    Margin="10,0,10,8"
                    Padding="12,10"
                    Background="{DynamicResource bg-2}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource corner}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top"
                           Fill="{Binding Tftp.Overall, Converter={StaticResource ReadinessBrush}}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"
                             Text="{Binding Tftp.Verdict}" />
                </Grid>

                <TextBlock Margin="22,4,0,0"
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Text="{Binding Tftp.VerdictRemediation}"
                           Visibility="{Binding Tftp.VerdictRemediation, Converter={StaticResource NotNullToVisible}}" />

                <ItemsControl ItemsSource="{Binding Tftp.Steps}" Margin="22,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2" ToolTip="{Binding Detail}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,4,6,0" VerticalAlignment="Top"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource txt-1}"
                                   Text="{Binding Summary}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource FaultNotice}"
                    Margin="10,0,10,8"
                    Visibility="{Binding Tftp.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" Text="{Binding Tftp.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0"
                           Visibility="{Binding Tftp.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Tftp.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <!-- Every file request exactly as the controller sent it. The filename is the payload:
                 no server log shows the name it refused, and a wrong path is a five-second fix that
                 otherwise costs an afternoon. -->
            <ListView ItemsSource="{Binding Tftp.Requests}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the other two lists. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      <Setter Property="Foreground" Value="{DynamicResource warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Fault">
                      <Setter Property="Background" Value="{DynamicResource row-bad}" />
                      <Setter Property="Foreground" Value="{DynamicResource bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="92" DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn Header="Request" Width="110" DisplayMemberBinding="{Binding OperationText}" />
                  <GridViewColumn Header="File, exactly as sent" Width="220">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding FileName}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Mode" Width="70" DisplayMemberBinding="{Binding ModeText}" />
                  <GridViewColumn Header="From" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SourceText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Arrived on" Width="160" DisplayMemberBinding="{Binding AdapterText}" />
                  <GridViewColumn Header="Options" Width="160" DisplayMemberBinding="{Binding OptionsText}" />
                  <GridViewColumn Header="Repeats" Width="66" DisplayMemberBinding="{Binding RepeatText}" />
                  <GridViewColumn Header="What happened" Width="460" DisplayMemberBinding="{Binding Message}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

      </TabControl>
    </Grid>

  </DockPanel>
</Window>
