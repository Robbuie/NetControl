<Window x:Class="NetControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetControl.App.ViewModels"
        xmlns:appearance="clr-namespace:NetControl.App.Appearance"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NetControl - BOOTP/DHCP"
        Height="720" Width="1180"
        MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ChromeWindow}">

  <!-- The title-bar menu is a resource, and MainWindow's constructor hands it to the shared title
       bar through Chrome.TitleContent. Attached-property element syntax for that was read by the
       markup compiler as a second child of the Window (MC3089), so it is wired up in code instead. -->
  <Window.Resources>
      <!-- The menu lives in the title bar, File Manager-style: one row that both drags the window
           and holds the menus, instead of a title bar and a menu bar stacked. -->
      <Menu x:Key="TitleMenu" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
        <!-- There is no Save. SQLite writes as the plan is typed, so a project can only ever be
             missing a location, never its contents - which is what Save as gives it. -->
        <MenuItem Header="_File">
          <MenuItem Header="_New project" Click="OnNewProject" />
          <MenuItem Header="_Open project..." Click="OnOpenProject" />
          <MenuItem Header="Save _as..." Click="OnSaveProjectAs"
                    ToolTip="Copies this project - plan, assignments and the whole event log - to a file, and keeps working there." />
          <Separator />
          <MenuItem Header="_Import plan from CSV..." Click="OnImportPlan"
                    ToolTip="Checks the whole file first. If anything in it is wrong, nothing is imported and every problem is listed with its line number." />
          <MenuItem Header="_Export plan to CSV..." Click="OnExportPlan"
                    ToolTip="The plan only. What was served and what was verified stay in the project's event log, which nothing can edit." />
          <Separator />
          <MenuItem Header="Export commissioning _report..." Click="OnExportReport"
                    ToolTip="The whole record as one HTML page for the customer: every device, what it was served, every write and its readback, the scans and the full event log. Prints to PDF from any browser." />
          <Separator />
          <MenuItem Header="E_xit" Click="OnExit" />
        </MenuItem>
        <MenuItem Header="_Listener">
          <MenuItem Header="_Watch" Command="{Binding StartWatchCommand}" />
          <MenuItem Header="_Serve" Command="{Binding StartServeCommand}" />
          <MenuItem Header="Sto_p" Command="{Binding StopCommand}" />
          <Separator />
          <MenuItem Header="_Re-check port and firewall" Command="{Binding RefreshEnvironmentCommand}" />
          <Separator />
          <MenuItem Header="DHCP _boot options..." Click="OnBootOptions"
                    ToolTip="Next server, TFTP server, boot file, domain and DNS for every reply this project serves. Blank by default." />
          <Separator />
          <MenuItem Header="Reply by per-socket _bind"
                    IsCheckable="True"
                    IsChecked="{Binding UsePerSocketBind}"
                    ToolTip="Off uses IP_UNICAST_IF on the listening socket. That path has only ever been proved against a listener on this machine, so the bind is the default until real hardware says otherwise." />
        </MenuItem>
        <MenuItem Header="_View">
          <!-- Theme, accent and density. The same three axes as the DWG viewer and the Redline PDF
               app, and the same design system underneath - so a person who set one of those up the
               way they like it will find this one already familiar. -->
          <MenuItem Header="_Appearance..." Click="OnAppearance"
                    ToolTip="Theme, accent colour and how much room the chrome takes. Applied as you choose, saved when you press OK." />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="_Subnet calculator..." Click="OnSubnetCalculator"
                    ToolTip="Network, broadcast, host range and mask for an address and prefix - and whether another address is on it. Opens on the selected adapter's own subnet." />
          <Separator />
          <MenuItem Header="_Ping the plan" Command="{Binding Diagnostics.PingPlanCommand}"
                    ToolTip="Pings every planned address and fills in the Reach column." />
          <MenuItem Header="_Diagnostics..." Click="OnDiagnoseSelectedRow"
                    ToolTip="Opens the Diagnostics tab on the selected plan row's device." />
        </MenuItem>
        <MenuItem Header="_Help">
          <!-- The startup check is silent unless there is a newer build. This one always answers,
               including "could not reach it", because somebody pressing it is waiting to be told. -->
          <MenuItem Header="Check for _updates" Click="OnCheckForUpdates"
                    ToolTip="Asks the repository whether a newer build has been published, and offers to download and install it. Refused while the listener is running or a device is being commissioned." />
          <MenuItem Header="_Releases page" Click="OnOpenReleases"
                    ToolTip="Opens the download page in a browser. Needs a machine with a route out - most plant laptops do not have one." />
          <Separator />
          <MenuItem Header="Open the _diagnostic log folder" Click="OnOpenLogFolder"
                    ToolTip="Why the application misbehaved. Not the commissioning record - that is the event log inside the project file, and nothing can edit it." />
          <Separator />
          <MenuItem Header="_About NetControl" Click="OnAbout" />
        </MenuItem>
      </Menu>
  </Window.Resources>

  <DockPanel>


    <!-- ============================ Interface bar ============================
         Always visible, and the first thing the eye lands on. "Nothing is arriving" has four
         common causes and three of them are measurable before a packet lands; this bar rules
         those three out so nobody has to guess which one they are looking at. -->
    <Border DockPanel.Dock="Top"
            Style="{StaticResource Card}"
            Margin="10,2,10,0"
            Padding="12,8">
      <StackPanel>

        <!-- Headline: the state light, the sentence, the adapter, and the controls. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Grid.Column="0"
                   Width="14" Height="14"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   Fill="{Binding InterfaceBar.Overall, Converter={StaticResource ReadinessBrush}}" />

          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="13"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding InterfaceBar.Headline}"
                     ToolTip="{Binding InterfaceBar.Headline}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,6,0" />

            <ComboBox Width="300"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding InterfaceBar.Adapters}"
                      SelectedItem="{Binding InterfaceBar.SelectedAdapter}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AdapterOption}">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Style.Triggers>
                            <!-- Dimmed, never hidden. The heuristic that calls an adapter
                                 virtual is only allowed to sort and shade, never to decide. -->
                            <DataTrigger Binding="{Binding IsLikelyVirtual}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPresent}" Value="False">
                              <Setter Property="Foreground" Value="{DynamicResource bad}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}">
                      <Run Text="{Binding AddressText, Mode=OneWay}" />
                      <Run Text=" - " />
                      <Run Text="{Binding LinkText, Mode=OneWay}" />
                      <Run Text=" - " />
                      <Run Text="{Binding Description, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Serve is armed separately from being started. Two deliberate actions, because a
                 rogue DHCP server on a plant network is a genuinely serious incident. -->
            <CheckBox Content="Arm serve"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      IsChecked="{Binding IsServeArmed}"
                      IsEnabled="{Binding InterfaceBar.CanArmServeMode}"
                      ToolTip="Serve mode answers only MACs that are in the plan, and only on the selected adapter." />

            <Button Content="Watch" Command="{Binding StartWatchCommand}" />
            <Button Content="Serve" Command="{Binding StartServeCommand}" />
            <Button Content="Stop" Command="{Binding StopCommand}" />
          </StackPanel>
        </Grid>

        <!-- One graded line per precondition. Grading rather than summarising is the point: a
             wildcard bind by VMware and Hyper-V holding its own address are both "port in use",
             and showing them the same way is what trains people to ignore the warning. -->
        <ItemsControl ItemsSource="{Binding InterfaceBar.Checks}" Margin="22,8,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding Detail}">
                <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource txt-2}"
                           Text="{Binding Summary}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- "Your device is asking, but on an adapter you did not select" - the most useful
             sentence this tool can produce, so it gets its own line rather than a log row. -->
        <Border Margin="22,8,0,0" Padding="8,5"
                Background="{DynamicResource notice-warn}"
                BorderBrush="{DynamicResource warn}"
                BorderThickness="1"
                Visibility="{Binding InterfaceBar.MisdirectedTraffic, Converter={StaticResource NotNullToVisible}}">
          <TextBlock TextWrapping="Wrap"
                     Foreground="{DynamicResource warn}"
                     Text="{Binding InterfaceBar.MisdirectedTraffic}" />
        </Border>

        <Border Margin="22,8,0,0" Padding="8,5"
                Background="{DynamicResource notice-bad}"
                BorderBrush="{DynamicResource bad}"
                BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisible}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource bad}"
                       Text="{Binding ErrorMessage}" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource bad}"
                       Visibility="{Binding ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                       Text="{Binding ErrorRemediation}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>

    <!-- ============================== Status bar ============================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource bg-1}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ProjectName}"
                     ToolTip="{Binding ProjectPath}" />
          <!-- Not a dirty flag. Edits are already in the database; what is missing is a file to
               keep it in, and saying that plainly is cheaper than a Save button people look for. -->
          <TextBlock Style="{StaticResource Muted}"
                     Foreground="{DynamicResource warn}"
                     Margin="6,0,0,0"
                     Text="(not saved to a file yet)"
                     ToolTip="Nothing is lost while the app is open, but nothing survives closing it either. File, Save as."
                     Visibility="{Binding IsUnsavedLocation, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}">
            <Run Text="{Binding PlannedDeviceCount, Mode=OneWay}" />
            <Run Text=" planned" />
          </TextBlock>
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}">
            <Run Text="{Binding Log.RequestCount, Mode=OneWay}" />
            <Run Text=" requests, " />
            <Run Text="{Binding Log.ServedCount, Mode=OneWay}" />
            <Run Text=" served, " />
            <Run Text="{Binding Log.UnknownDeviceCount, Mode=OneWay}" />
            <Run Text=" unknown" />
          </TextBlock>

          <!-- Which build this is. The first question anybody asks about an exe somebody copied
               onto a laptop, and the same string the project file records - so a commissioning
               record and the tool in front of you can be matched without opening either. -->
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}"
                     Text="{Binding VersionText, Mode=OneTime}"
                     ToolTip="The build that is running. It is written into every project file this session opens." />

          <!-- Absent unless there is something to say. Every ordinary state - the check turned
               off, already on the current build, and a check that could not reach anything - is
               silence at startup, because a status bar with something in it at all times is a
               status bar nobody reads. What is left is worth clicking: this line only appears when
               a newer build exists, and clicking it is how you install it. -->
          <TextBlock Style="{StaticResource Muted}"
                     Foreground="{DynamicResource warn}"
                     Margin="10,0,0,0"
                     TextTrimming="CharacterEllipsis"
                     Cursor="Hand"
                     MouseLeftButtonUp="OnUpdateStatusClicked"
                     Text="{Binding UpdateStatus}"
                     ToolTip="Click to download and install it. Same as Help &gt; Check for updates."
                     Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding InterfaceBar.OuiSummary}"
                   Text="{Binding InterfaceBar.OuiSummary}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding InterfaceBar.OuiIsStale}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="2"
                   Foreground="{DynamicResource bad}"
                   FontWeight="SemiBold"
                   Visibility="{Binding RecordingIsIncomplete, Converter={StaticResource BoolToVisible}}"
                   Text="Event log incomplete - a row failed to write"
                   ToolTip="The listener kept serving, but the commissioning record has a hole in it. The detail is in the log." />
      </Grid>
    </Border>

    <!-- The plan above, the wire below, both visible at once. That is the working loop: you watch
         a device ask, you plan it, and it is served on its next retransmit. Tabs would hide one
         half of that from the other. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="140" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" MinHeight="120" />
      </Grid.RowDefinitions>

      <!-- ================================ Plan grid ================================
           Edits go straight into the project file as each cell is left, and straight into the
           policy the receive loop reads. There is no Save button because there is nothing to
           save - see the status bar. -->
      <!-- Each working area is a card on the backdrop, as in File Manager. -->
      <Border Grid.Row="0" Style="{StaticResource Card}" Margin="10,8,10,0" Padding="8,6,8,0">
      <DockPanel>

        <!-- A WrapPanel rather than a StackPanel since the toolbar grew a second group: on a narrow
             window the diagnostics buttons drop to a second line instead of off the edge. -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Plan" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center">
            <Run Text="{Binding Plan.ServableCount, Mode=OneWay}" />
            <Run Text=" of " />
            <Run Text="{Binding Plan.Rows.Count, Mode=OneWay}" />
            <Run Text=" rows complete and servable" />
          </TextBlock>
          <Button Content="Add device" Margin="16,0,0,0" Command="{Binding Plan.AddDeviceCommand}" />
          <Button Content="Remove" Command="{Binding Plan.RemoveDeviceCommand}" />

          <!-- The half of the job BOOTP does not do. An address served over BOOTP lasts until the
               next power cycle, because the device is still a BOOTP client; this writes it in and
               turns the protocol off, then reads it back off the device before saying so. -->
          <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

          <Button Content="Set static"
                  MinWidth="110"
                  Command="{Binding Plan.SetStaticCommand}"
                  ToolTip="Writes the planned address into the selected device and disables BOOTP/DHCP, then reads it back to confirm it took. Sent only to that one device." />

          <!-- Its own control, because on a running line resetting a module is an outage and
               nobody should discover they authorised one by pressing the button next to it. -->
          <CheckBox Content="Allow reset if needed"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    IsChecked="{Binding Plan.AllowDeviceReset}"
                    ToolTip="Some adapters hold a written configuration until the interface is reset. Left off, such a device is reported unverified rather than quietly restarted." />

          <!-- The reverse operation. Handing a device back to a plant DHCP server is a real job at
               the end of a commissioning - but it is also how a device stops owning its address, so
               it is chosen by name, from a menu, behind a confirmation, rather than arrived at by
               leaving a dropdown where somebody else left it. IsEnabled binds to the same rule the
               commands use; a second copy of it written here is a copy that drifts. -->
          <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                Margin="10,0,0,0" Padding="0">
            <MenuItem Header="Enable BOOTP/DHCP"
                      ToolTip="Writes Configuration Control and nothing else. The addresses the device is holding are left alone, but it stops owning them and asks for one again at its next power cycle.">
              <MenuItem Header="Enable _BOOTP on the selected device"
                        IsEnabled="{Binding Plan.CanHandBack}"
                        Click="OnEnableBootp" />
              <MenuItem Header="Enable _DHCP on the selected device"
                        IsEnabled="{Binding Plan.CanHandBack}"
                        Click="OnEnableDhcp" />
            </MenuItem>
          </Menu>

          <!-- The same sequence, over every row that is ready and not yet Verified, one device at a
               time. The confirmation names each device; Stop takes effect between devices, never in
               the middle of one, because half a write is the worst place to leave a device. -->
          <Button Content="Set static on all..."
                  Margin="10,0,0,0"
                  Command="{Binding Plan.SetStaticAllCommand}"
                  ToolTip="Set static on every complete row not already Verified, one device at a time, after a confirmation that lists them. Each is written only at its own planned address." />
          <Button Content="Stop"
                  Command="{Binding Plan.StopBulkCommand}"
                  Visibility="{Binding Plan.IsBulkRunning, Converter={StaticResource BoolToVisible}}"
                  ToolTip="Stops after the device in progress. That one is allowed to finish." />

          <TextBlock Style="{StaticResource Muted}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource warn}"
                     Text="Writing to device..."
                     Visibility="{Binding Plan.IsCommissioning, Converter={StaticResource BoolToVisible}}" />

          <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

          <!-- Reads. Nothing in this group writes to anything. -->
          <Button Content="Ping plan"
                  Command="{Binding Diagnostics.PingPlanCommand}"
                  ToolTip="Pings every planned address, a few at a time, and fills in the Reach column. An answer proves something is at that address - not that it is the device the plan meant." />
          <Button Content="Diagnose"
                  Click="OnDiagnoseSelectedRow"
                  ToolTip="Opens the Diagnostics tab on the selected device: ping, its own link and fault counters over EtherNet/IP, and which services it offers. Nothing is sent until you press a button there." />

          <TextBlock Style="{StaticResource Muted}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     MaxWidth="520"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Plan.BulkStatus}"
                     ToolTip="{Binding Plan.BulkStatus}"
                     Visibility="{Binding Plan.BulkStatus, Converter={StaticResource NotNullToVisible}}" />
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,6,0,8" Padding="8,5"
                Background="{DynamicResource notice-bad}"
                BorderBrush="{DynamicResource bad}"
                BorderThickness="1"
                Visibility="{Binding Plan.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource bad}"
                       Text="{Binding Plan.ErrorMessage}" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource bad}"
                       Visibility="{Binding Plan.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                       Text="{Binding Plan.ErrorRemediation}" />
          </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Plan.Rows}"
                  SelectedItem="{Binding Plan.SelectedRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

          <!-- The row carries its own explanation. A panel underneath would make somebody match a
               message to a line by eye, and DataGrid's own validation paints a red box with no
               sentence in it at all. Red means it was not stored; amber means it was stored and
               will not be served, which is a normal state for a plan being typed. -->
          <DataGrid.RowStyle>
            <!-- BasedOn, and it is load-bearing: an explicit RowStyle replaces the implicit one
                 rather than adding to it, so without this the grid keeps its triggers and loses
                 its template - which is to say it stops following the theme entirely. -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsServable}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource row-warn}" />
                </DataTrigger>
                <!-- Last trigger wins, so this deliberately follows the amber one. -->
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource row-bad}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource good}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServable}" Value="False">
                            <Setter Property="Fill" Value="{DynamicResource warn}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource bad}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="MAC" Width="150"
                                Binding="{Binding MacText}"
                                ElementStyle="{StaticResource MonoText}" />
            <DataGridTextColumn Header="Planned IP" Width="120" Binding="{Binding IpText}" />
            <DataGridTextColumn Header="Subnet mask" Width="120" Binding="{Binding MaskText}" />
            <DataGridTextColumn Header="Gateway" Width="120" Binding="{Binding GatewayText}" />
            <DataGridTextColumn Header="Host name" Width="130" Binding="{Binding HostName}" />
            <DataGridTextColumn Header="Panel" Width="100" Binding="{Binding PanelRef}" />
            <DataGridTextColumn Header="Role" Width="150" Binding="{Binding Role}" />

            <!-- Derived from the MAC and stored at that moment, so the file still reads correctly
                 when the IEEE registry moves on. A hand-typed vendor that disagreed with the MAC
                 would be worse than none, hence read-only. -->
            <DataGridTextColumn Header="Vendor" Width="170" IsReadOnly="True"
                                Binding="{Binding Vendor, Mode=OneWay}" />

            <DataGridTextColumn Header="State" Width="80" IsReadOnly="True"
                                Binding="{Binding State, Mode=OneWay}" />

            <!-- The last ping, this session only. Amber for silence, never red: plenty of drives and
                 I/O adapters ignore ping, and a column that shouts about them gets ignored. -->
            <DataGridTextColumn Header="Reach" Width="70" IsReadOnly="True"
                                Binding="{Binding ReachText, Mode=OneWay}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="ToolTip" Value="{Binding ReachTooltip}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ReachIsSilent}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource warn}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- What this device is known to do wrong - learned from a Set static or ticked by hand.
                 Read-only here; the editor is on the row's right-click menu, because each flag needs
                 its sentence beside it to be chosen honestly. -->
            <DataGridTextColumn Header="Quirks" Width="110" IsReadOnly="True"
                                Binding="{Binding QuirksText, Mode=OneWay}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="ToolTip" Value="{Binding QuirksTooltip}" />
                  <Setter Property="Foreground" Value="{DynamicResource warn}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Notes" Width="220" Binding="{Binding Notes}" />
          </DataGrid.Columns>

          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Device _quirks..." Click="OnEditQuirks"
                        ToolTip="What this device is known to do wrong, and what NetControl does about each." />
              <MenuItem Header="_Diagnose this device" Click="OnDiagnoseSelectedRow" />
              <MenuItem Header="_Read Modbus registers" Click="OnModbusSelectedRow"
                        ToolTip="Opens the Modbus tab on this device's planned address. Read-only." />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
      </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1"
                    Height="7"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ShowsPreview="True" />

      <!-- ============================= Live request log =============================
           Every request as it lands, with the adapter it arrived on, the vendor behind the MAC,
           and whether it matched a planned device. Newest first, so nothing has to auto-scroll. -->
      <!-- The two halves of discovery, kept apart on purpose. A device in the live log asked for
           an address; a device in the scan results already has one and did not ask for anything.
           Both feed the same "add to plan" action, and a list that conflated them would mislead. -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="10,6,10,8" Padding="4">
      <TabControl>

        <!-- ============================ Live request log ============================
             Every request as it lands, with the adapter it arrived on, the vendor behind the MAC,
             and whether it matched a planned device. Newest first, so nothing has to auto-scroll. -->
        <TabItem Header="Live requests">
          <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <CheckBox Content="Only devices that are not in the plan"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Log.ShowOnlyUnknownDevices}" />
              <Button Content="Clear" Margin="16,0,0,0" Command="{Binding ClearLogCommand}" />
            </StackPanel>

            <ListView ItemsSource="{Binding Log.Entries}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <!-- The row menu lives here rather than inline in the Setter below, and it has to.
                   A Click handler inside a Setter.Value does compile, but the XAML compiler wires it
                   through IStyleConnector, whose connection ids only line up for EventSetters - so the
                   handler lands on whatever element is connected next (the GridView) and the build
                   fails talking about a type that has nothing to do with it. As a keyed resource it
                   goes through the ordinary component connector and behaves. -->
              <ListView.Resources>
                <ContextMenu x:Key="LogRowMenu">
                  <MenuItem Header="_Add to plan" Click="OnAddToPlan"
                            ToolTip="Adds this MAC to the plan, ready for you to type its address. Nothing is sent." />
                </ContextMenu>
              </ListView.Resources>

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the plan grid's RowStyle: an explicit
                     container style replaces the implicit one instead of extending it. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                  <!-- Watch a device ask, double-click it, and its MAC is in the plan - served on its
                       next retransmit, once you have typed an address for it. Adding a row transmits
                       nothing by itself; Serve mode still has to be armed and started separately. -->
                  <EventSetter Event="MouseDoubleClick" Handler="OnLogRowDoubleClicked" />

                  <!-- One menu instance shared by every row, so the handler resolves the row it was
                       opened on through PlacementTarget rather than through its own data context. -->
                  <Setter Property="ContextMenu" Value="{StaticResource LogRowMenu}" />

                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Outcome}" Value="Served">
                      <Setter Property="Background" Value="{DynamicResource row-good}" />
                    </DataTrigger>
                    <!-- A stranger on the network reads differently from a device you are waiting for.
                         Last trigger wins, so this deliberately follows Served. -->
                    <DataTrigger Binding="{Binding IsUnknownDevice}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-unknown}" />
                    </DataTrigger>
                    <!-- Amber, matching how the interface bar grades the same finding. Red is reserved
                         for a fault that actually stopped something. -->
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      <Setter Property="Foreground" Value="{DynamicResource warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Fault">
                      <Setter Property="Background" Value="{DynamicResource row-bad}" />
                      <Setter Property="Foreground" Value="{DynamicResource bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="92" DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn Header="Message type" Width="120" DisplayMemberBinding="{Binding Label}" />
                  <GridViewColumn Header="MAC" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding MacText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <!-- What the plan calls this device, snapshotted when the row was made. Ahead of
                       Vendor because on a bench you read this log against a printed plan, and "Conveyor
                       3 drive" finds the line quicker than a MAC or a manufacturer does. -->
                  <GridViewColumn Header="Device" Width="180" DisplayMemberBinding="{Binding NameText}" />
                  <GridViewColumn Header="Vendor" Width="190" DisplayMemberBinding="{Binding VendorText}" />
                  <GridViewColumn Header="Arrived on" Width="170" DisplayMemberBinding="{Binding AdapterText}" />
                  <GridViewColumn Header="Repeats" Width="66" DisplayMemberBinding="{Binding RepeatText}" />
                  <GridViewColumn Header="What happened" Width="460" DisplayMemberBinding="{Binding Message}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- ============================== Scan results ==============================
             Devices that already have an address, found by asking rather than by waiting. A device
             here does not need BOOTP - so the value of a scan is verification (did the device we
             served come up where we said), conflict detection (something is already on that
             address) and inventory. Pressing Scan transmits; nothing here writes to a device. -->
        <TabItem Header="Scan results">
          <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <Button Content="Scan"
                      MinWidth="90"
                      Command="{Binding ScanCommand}"
                      ToolTip="Asks every EtherNet/IP device on the selected adapter to identify itself. One broadcast on UDP/44818, nothing written to anything." />
              <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearScanCommand}" />
              <TextBlock Style="{StaticResource Muted}"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Scan.Status}" />
            </StackPanel>

            <!-- What the scan had to say about the plan.
                 Its own panel rather than only a column, because a finding is a relationship
                 between two lists - "this address is planned for that device" - and the plan row it
                 is about may not be visible anywhere on this tab. Every finding that does concern a
                 device in the list below also lands in that device's own Note, so nothing here has
                 to be matched up by eye. Confirmations and unplanned devices are not listed: they
                 are in the row notes and in the summary tally, and a panel that scrolls is one
                 whose bottom entries nobody reads. -->
            <Border DockPanel.Dock="Bottom"
                    Style="{StaticResource WarningNotice}"
                    Margin="10,0,10,8"
                    Visibility="{Binding Scan.HasFindings, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <TextBlock Text="The plan and the segment disagree"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Scan.Findings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <!-- What changed since the last scan of this subnet (PLAN-TOOLKIT.md F5): a device that
                 moved, a module swapped for another, firmware that changed, something new, something
                 silent. Absent after the first scan of a subnet, which has nothing to compare with. -->
            <Border DockPanel.Dock="Bottom"
                    Margin="10,0,10,8"
                    Padding="10,8"
                    Background="{DynamicResource bg-2}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource corner}"
                    Visibility="{Binding Scan.ChangesSummary, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="{Binding Scan.ChangesSummary}" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Scan.Changes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,1">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                  <Setter Property="Foreground" Value="{DynamicResource warn}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding Scan.Rows}"
                      SelectedItem="{Binding Scan.SelectedRow}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <!-- Keyed, not inline in the Setter below, for the reason spelled out on the log's
                   own row menu: a Click handler inside a Setter.Value is wired through
                   IStyleConnector and lands on the wrong element. -->
              <ListView.Resources>
                <ContextMenu x:Key="ScanRowMenu">
                  <MenuItem Header="_Add to plan" Click="OnAddScanResultToPlan"
                            ToolTip="Adds this device to the plan at the address it is already holding. Nothing is sent." />
                  <MenuItem Header="_Diagnose this device" Click="OnDiagnoseScanResult"
                            ToolTip="Opens the Diagnostics tab on this device's address. Nothing is sent until you press a button there." />
                </ContextMenu>
              </ListView.Resources>

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the plan grid's RowStyle: an explicit
                     container style replaces the implicit one instead of extending it. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <EventSetter Event="MouseDoubleClick" Handler="OnScanRowDoubleClicked" />
                  <Setter Property="ContextMenu" Value="{StaticResource ScanRowMenu}" />

                  <Style.Triggers>
                    <!-- Amber for a row that needs a person: a MAC that could not be resolved, or
                         two devices on one address. Last trigger wins, so "already planned" sits
                         after it - a device you have dealt with reads as dealt with. -->
                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAlreadyPlanned}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource row-good}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Address" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding AddressText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Product" Width="230" DisplayMemberBinding="{Binding ProductText}" />
                  <GridViewColumn Header="Rev" Width="56" DisplayMemberBinding="{Binding RevisionText}" />
                  <GridViewColumn Header="Serial" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SerialText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="MAC" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding MacText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Vendor" Width="190" DisplayMemberBinding="{Binding VendorText}" />
                  <GridViewColumn Header="Note" Width="420" DisplayMemberBinding="{Binding Note}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- ============================== TFTP backup ==============================
             PLAN-TFTP.md parts E1, E3 and E5. A FANUC image backup over Ethernet is a BOOTP request
             followed by a TFTP write request, and when it "never starts" nobody can say which half
             broke. This tab watches the second half and, together with the BOOTP listener at the top
             of the window, says which step the backup stopped at. Watching refuses every request on
             purpose: it records what the controller asked for and never receives the image. -->
        <TabItem Header="TFTP backup">
          <DockPanel>

            <!-- Where this PC stands, then the watch. The vantage tick changes how UDP/69 is graded:
                 on the backup server, nothing holding the port is the fault; on a laptop it is what
                 lets the watch bind. -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <CheckBox Content="This PC is the backup server"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        IsChecked="{Binding Tftp.IsBackupServer}"
                        ToolTip="Tick on the PC the robots back up to. Leave clear on a laptop plugged into the robot network." />

              <TextBlock Text="Backup folder" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Width="240"
                       VerticalAlignment="Center"
                       Text="{Binding Tftp.RootFolder, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The TFTP server's root folder. Checked by writing a small probe file into it and deleting it again." />
              <Button Content="Browse..." Margin="6,0,0,0" Click="OnBrowseTftpRoot" />
              <Button Content="Check folder" Command="{Binding Tftp.CheckRootCommand}" />

              <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

              <!-- Armed separately from being started, like Serve: a refusal is a transmission. -->
              <CheckBox Content="Arm"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        IsChecked="{Binding Tftp.IsWatchArmed}"
                        ToolTip="The watch answers each request with a refusal, on the adapter selected at the top of the window only. Stop the real TFTP server first - the watch will not share UDP/69 with it." />
              <CheckBox Content="Receive the backup"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        IsChecked="{Binding Tftp.IsAcceptMode}"
                        ToolTip="Accept mode: receive the backup into the folder instead of refusing it, to prove the robot and the network work. Never writes outside the folder. Takes effect at the next start." />
              <CheckBox Content="Allow overwrite"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        IsChecked="{Binding Tftp.AllowOverwrite}"
                        IsEnabled="{Binding Tftp.IsAcceptMode}"
                        ToolTip="Let a received backup replace a file of the same name. Off, as most TFTP servers ship." />
              <Button Content="Watch TFTP" Command="{Binding Tftp.StartWatchCommand}" />
              <Button Content="Stop" Command="{Binding Tftp.StopWatchCommand}" />
              <Button Content="Re-check" Command="{Binding Tftp.RefreshCommand}"
                      ToolTip="Who holds UDP/69 on this PC, whether the firewall lets it in, and the backup folder." />
              <Button Content="Clear" Command="{Binding Tftp.ClearCommand}"
                      ToolTip="Empties the list and starts the verdict over, for the next attempt." />

              <Border Style="{StaticResource ToolbarSeparator}" Height="20" />

              <CheckBox Content="Probe a server"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Tftp.IsProbeVisible}"
                        ToolTip="Write a test file to the real TFTP server from this PC and read it back." />
            </WrapPanel>

            <!-- The probe (PLAN-TFTP.md part E4): be the client, against the real server. The only
                 thing in the tool that writes to plant infrastructure over TFTP, so it needs its own
                 tick on every run, writes only the name typed here, and never deletes anything. -->
            <Border DockPanel.Dock="Top"
                    Margin="10,0,10,8"
                    Padding="12,10"
                    Background="{DynamicResource bg-2}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource corner}"
                    Visibility="{Binding Tftp.IsProbeVisible, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Width="130" VerticalAlignment="Center"
                           Text="{Binding Tftp.ProbeServer, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="The TFTP server's address, as set on the controller." />
                  <TextBlock Text="Test file" VerticalAlignment="Center" Margin="12,0,6,0" />
                  <TextBox Width="230" VerticalAlignment="Center"
                           Text="{Binding Tftp.ProbeFileName, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Written to the server and left there. Never the name of a real backup." />
                  <TextBlock Text="Size (MB)" VerticalAlignment="Center" Margin="12,0,6,0" />
                  <TextBox Width="50" VerticalAlignment="Center"
                           Text="{Binding Tftp.ProbeSizeMegabytes, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="40 MB by default: past the 32 MB a 512-byte block counter can reach, so one run shows whether this server survives the rollover." />
                  <CheckBox Content="Read it back" Margin="12,0,0,0" VerticalAlignment="Center"
                            IsChecked="{Binding Tftp.ProbeReadBack}" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <CheckBox VerticalAlignment="Center" Margin="0,0,12,0"
                            IsChecked="{Binding Tftp.ProbeConfirmed}"
                            Content="Write this file to that server - it is left there" />
                  <Button Content="Run probe" Command="{Binding Tftp.RunProbeCommand}"
                          ToolTip="Leaves from the adapter selected at the top of the window, the way the robot's backup does." />
                  <Button Content="Cancel" Command="{Binding Tftp.RunProbeCancelCommand}" />
                  <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{Binding Tftp.ProbeStatus}" />
                </WrapPanel>

                <Grid Margin="0,10,0,0"
                      Visibility="{Binding Tftp.ProbeSummary, Converter={StaticResource NotNullToVisible}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,3,8,0" VerticalAlignment="Top"
                           Fill="{Binding Tftp.ProbeState, Converter={StaticResource ReadinessBrush}}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"
                             Text="{Binding Tftp.ProbeSummary}" />
                </Grid>
                <TextBlock Margin="20,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="{Binding Tftp.ProbeRemediation}"
                           Visibility="{Binding Tftp.ProbeRemediation, Converter={StaticResource NotNullToVisible}}" />
                <ItemsControl ItemsSource="{Binding Tftp.ProbeFindings}" Margin="20,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                 Foreground="{DynamicResource txt-1}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- This PC, graded the way the interface bar grades UDP/67 - but on its own row, because
                 the same fact (a TFTP server holding the port) is good news here and bad news there. -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tftp.Checks}" Margin="12,0,10,6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding Detail}">
                    <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource txt-2}"
                               Text="{Binding Summary}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The verdict. One line per step, each grey until it has actually been seen, and above
                 them the one sentence that names the earliest step not known to have worked. -->
            <Border DockPanel.Dock="Top"
                    Margin="10,0,10,8"
                    Padding="12,10"
                    Background="{DynamicResource bg-2}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource corner}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top"
                           Fill="{Binding Tftp.Overall, Converter={StaticResource ReadinessBrush}}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"
                             Text="{Binding Tftp.Verdict}" />
                </Grid>

                <TextBlock Margin="22,4,0,0"
                           Style="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Text="{Binding Tftp.VerdictRemediation}"
                           Visibility="{Binding Tftp.VerdictRemediation, Converter={StaticResource NotNullToVisible}}" />

                <ItemsControl ItemsSource="{Binding Tftp.Steps}" Margin="22,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2" ToolTip="{Binding Detail}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,4,6,0" VerticalAlignment="Top"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource txt-1}"
                                   Text="{Binding Summary}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource FaultNotice}"
                    Margin="10,0,10,8"
                    Visibility="{Binding Tftp.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" Text="{Binding Tftp.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0"
                           Visibility="{Binding Tftp.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Tftp.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <!-- Every file request exactly as the controller sent it. The filename is the payload:
                 no server log shows the name it refused, and a wrong path is a five-second fix that
                 otherwise costs an afternoon. -->
            <ListView ItemsSource="{Binding Tftp.Requests}"
                      Margin="10,0,10,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

              <ListView.ItemContainerStyle>
                <!-- BasedOn for the same reason as the other two lists. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Style.Triggers>
                    <!-- A finished transfer Accept mode received. -->
                    <DataTrigger Binding="{Binding Kind}" Value="Reply">
                      <Setter Property="Background" Value="{DynamicResource row-good}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                      <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      <Setter Property="Foreground" Value="{DynamicResource warn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Fault">
                      <Setter Property="Background" Value="{DynamicResource row-bad}" />
                      <Setter Property="Foreground" Value="{DynamicResource bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>

              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="92" DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn Header="Request" Width="110" DisplayMemberBinding="{Binding OperationText}" />
                  <GridViewColumn Header="File, exactly as sent" Width="220">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding FileName}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Mode" Width="70" DisplayMemberBinding="{Binding ModeText}" />
                  <GridViewColumn Header="From" Width="150">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SourceText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Arrived on" Width="160" DisplayMemberBinding="{Binding AdapterText}" />
                  <GridViewColumn Header="Options" Width="160" DisplayMemberBinding="{Binding OptionsText}" />
                  <GridViewColumn Header="Repeats" Width="66" DisplayMemberBinding="{Binding RepeatText}" />
                  <GridViewColumn Header="What happened" Width="460" DisplayMemberBinding="{Binding Message}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <!-- ============================== Diagnostics ==============================
             PLAN-TOOLKIT.md F1-F3. One device, three questions: does anything answer at its
             address, what does it say about its own health over EtherNet/IP, and which services does
             it offer. Every button here is a read, unicast to the one address in the box; nothing on
             this tab writes to a device. Each still gets a row in the event log, because it put packets
             on somebody's network. -->
        <TabItem Header="Diagnostics" x:Name="DiagnosticsTab">
          <DockPanel>

            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Width="140"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource mono}"
                       Text="{Binding Diagnostics.TargetText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="One device's address. Pick a row in the plan or a scan result and press Diagnose, or type it." />
              <TextBlock Style="{StaticResource Muted}"
                         Margin="8,0,12,0"
                         VerticalAlignment="Center"
                         MaxWidth="260"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Diagnostics.TargetName}" />

              <Button Content="Ping"
                      Command="{Binding Diagnostics.PingTargetCommand}"
                      ToolTip="ICMP echo, up to two attempts. Many drives and I/O adapters ignore ping, so silence is not proof the device is off." />
              <Button Content="Read device diagnostics"
                      Command="{Binding Diagnostics.ReadHealthCommand}"
                      ToolTip="Reads the device's identity, fault status, address settings and every port's link and error counters over EtherNet/IP. Read-only: it never clears a counter. Read twice to see which counters are still moving." />
              <Button Content="Check services"
                      Command="{Binding Diagnostics.CheckServicesCommand}"
                      ToolTip="Connects to a short list of TCP ports one at a time. On an open port it asks one read-only question that only the real protocol answers - EtherNet/IP identity, Modbus device ID, an S7 connect, MELSEC CPU model, an OPC UA hello, an HTTP HEAD - so an open port is proven, not assumed." />
              <Button Content="Open web page"
                      Click="OnOpenDeviceWebPage"
                      Visibility="{Binding Diagnostics.WebPage, Converter={StaticResource NotNullToVisible}}"
                      ToolTip="The device's own web page, in a browser. Usually where its detailed diagnostics are." />

              <TextBlock Style="{StaticResource Muted}"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         MaxWidth="560"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Diagnostics.Status}"
                         ToolTip="{Binding Diagnostics.Status}" />
            </WrapPanel>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource FaultNotice}"
                    Margin="10,0,10,8"
                    Visibility="{Binding Diagnostics.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" Text="{Binding Diagnostics.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0"
                           Visibility="{Binding Diagnostics.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Diagnostics.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <!-- This PC's half of the link. A damaged patch lead between the laptop and the switch looks,
                 from everywhere else in the tool, exactly like a device problem. -->
            <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="This PC's adapter counters"
                      VerticalAlignment="Top"
                      Command="{Binding Diagnostics.ReadAdapterCountersCommand}"
                      ToolTip="Asks Windows for the selected adapter's own error and discard counters. Read twice: errors still being counted on this PC's adapter are this PC's cable, port or dock." />
              <TextBlock Grid.Column="1" Margin="10,3,0,0" TextWrapping="Wrap"
                         Text="{Binding Diagnostics.AdapterCountersText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Diagnostics.AdapterHasNewErrors}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource warn}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>

            <TextBlock DockPanel.Dock="Top"
                       Margin="12,0,10,6"
                       TextWrapping="Wrap"
                       Text="{Binding Diagnostics.PingResult}"
                       Visibility="{Binding Diagnostics.PingResult, Converter={StaticResource NotNullToVisible}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="10,0,10,8">

                <!-- The health read: who the device says it is, how it says it is addressed, what is
                     wrong (worst first), and every port. -->
                <Border Padding="12,10"
                        Margin="0,0,0,8"
                        Background="{DynamicResource bg-2}"
                        BorderBrush="{DynamicResource line}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource corner}"
                        Visibility="{Binding Diagnostics.HasHealth, Converter={StaticResource BoolToVisible}}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Diagnostics.HealthTitle}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource txt-1}"
                               Text="{Binding Diagnostics.HealthNetworkText}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{Binding Diagnostics.HealthComparison}" />

                    <ItemsControl ItemsSource="{Binding Diagnostics.Findings}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,4,8,0" VerticalAlignment="Top">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Fill" Value="{DynamicResource txt-2}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warn">
                                      <Setter Property="Fill" Value="{DynamicResource warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                      <Setter Property="Fill" Value="{DynamicResource bad}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Message}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Diagnostics.Ports}" Margin="0,10,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="60" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold">
                              <Run Text="Port " /><Run Text="{Binding PortText, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                              <TextBlock TextWrapping="Wrap">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsHalfDuplex}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource warn}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding HasFault}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource bad}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding LinkText, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Text="{Binding MacText, Mode=OneWay}" FontFamily="{DynamicResource mono}" />
                              </TextBlock>
                              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                         Text="{Binding MediaText}" />
                              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                         Text="{Binding InterfaceText}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Diagnostics.HealthNotes}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- The service check: one row per port asked about, open ones first in the eye. -->
                <ItemsControl ItemsSource="{Binding Diagnostics.Services}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="60" />
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Service.Port}" />
                        <TextBlock Grid.Column="1" Text="{Binding Service.Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding StateText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource txt-0}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource good}" />
                                </DataTrigger>
                                <!-- Open but the handshake did not prove the protocol: something else is
                                     squatting on a well-known port, and that is worth the eye. -->
                                <DataTrigger Binding="{Binding IsUnverified}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource warn}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="3" TextTrimming="CharacterEllipsis"
                                   Text="{Binding DetailText}" ToolTip="{Binding DetailText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource txt-1}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ================================ Modbus ================================
             Reads only: coils, inputs, holding and input registers, decoded every common way.
             There is no write anywhere in this tab, by design - see ModbusViewModel. -->
        <TabItem Header="Modbus" x:Name="ModbusTab">
          <DockPanel>

            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,6">
              <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Width="130" VerticalAlignment="Center" FontFamily="{DynamicResource mono}"
                       Text="{Binding Modbus.TargetText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="One device's address. Right-click a plan row > Read Modbus registers, or type it." />
              <TextBlock Text="Port" VerticalAlignment="Center" Margin="10,0,6,0" />
              <TextBox Width="54" VerticalAlignment="Center" FontFamily="{DynamicResource mono}"
                       Text="{Binding Modbus.PortText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Unit" VerticalAlignment="Center" Margin="10,0,6,0" />
              <TextBox Width="44" VerticalAlignment="Center" FontFamily="{DynamicResource mono}"
                       Text="{Binding Modbus.UnitIdText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Unit id: 1 for most devices on Ethernet. Behind a gateway, the serial address of the device. 255 asks the gateway itself." />
              <ComboBox Width="220" Margin="10,0,0,0" VerticalAlignment="Center"
                        ItemsSource="{Binding Modbus.Functions}"
                        SelectedItem="{Binding Modbus.Function}"
                        DisplayMemberPath="Label" />
              <TextBlock Text="Start" VerticalAlignment="Center" Margin="10,0,6,0" />
              <TextBox Width="64" VerticalAlignment="Center" FontFamily="{DynamicResource mono}"
                       Text="{Binding Modbus.StartText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Zero-based, as sent on the wire: holding register 40001 is start 0. The results show both numberings." />
              <TextBlock Text="Count" VerticalAlignment="Center" Margin="10,0,6,0" />
              <TextBox Width="54" VerticalAlignment="Center" FontFamily="{DynamicResource mono}"
                       Text="{Binding Modbus.CountText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Up to 125 registers or 2000 bits - the protocol's limit. Many devices accept fewer." />

              <Button Content="Read" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                      Command="{Binding Modbus.ReadCommand}"
                      ToolTip="One read. Recorded in the project." />
              <Button Content="Poll every second"
                      Command="{Binding Modbus.StartPollCommand}"
                      ToolTip="Reads once a second until stopped or a read fails - to watch a value change. Two rows in the record: the start and the stop." />
              <Button Content="Stop" Command="{Binding Modbus.StopPollCommand}" />

              <TextBlock Text="32-bit order" VerticalAlignment="Center" Margin="14,0,6,0" />
              <ComboBox Width="110" VerticalAlignment="Center"
                        ItemsSource="{Binding Modbus.WordOrders}"
                        SelectedItem="{Binding Modbus.WordOrder}"
                        ToolTip="HighFirst is ABCD, the usual; LowFirst is CDAB, 'word swapped'. Changing it re-decodes the last read without reading again." />
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" Margin="12,0,10,6" Style="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Modbus.Status}" ToolTip="{Binding Modbus.Status}" />

            <Border DockPanel.Dock="Top" Style="{StaticResource FaultNotice}" Margin="10,0,10,8"
                    Visibility="{Binding Modbus.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" TextWrapping="Wrap" Text="{Binding Modbus.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Modbus.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Modbus.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="10,0,10,8" Padding="4">
              <DataGrid ItemsSource="{Binding Modbus.Rows}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Extended"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Address" Width="70" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Reference" Width="80" Binding="{Binding Reference, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Unsigned" Width="80" Binding="{Binding Unsigned, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Signed" Width="80" Binding="{Binding Signed, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Hex" Width="70" Binding="{Binding Hex, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Binary" Width="150" Binding="{Binding Binary, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Float (this + next)" Width="130" Binding="{Binding FloatText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Int32 (this + next)" Width="130" Binding="{Binding Int32Text, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="UInt32 (this + next)" Width="*" Binding="{Binding UInt32Text, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>

        <!-- ================================ Passive ================================
             Listen-only inventory: every device heard, nothing sent. Needs Npcap; without it the
             tab says what to install and nothing else in the app notices. -->
        <TabItem Header="Passive" x:Name="PassiveTab">
          <DockPanel Loaded="OnPassiveTabShown">

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,8,10,6" Padding="12,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="Npcap: " FontWeight="SemiBold" /><Run Text="{Binding Passive.AvailabilityText, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                             Visibility="{Binding Passive.Remediation, Converter={StaticResource NotNullToVisible}}"
                             Text="{Binding Passive.Remediation}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Get Npcap" Click="OnGetNpcap"
                          ToolTip="Opens npcap.com. Free for use on your own machines; Wireshark's installer includes it too." />
                  <Button Content="Check again" Command="{Binding Passive.CheckAvailabilityCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,6">
              <Button Content="Start listening" Style="{StaticResource PrimaryButton}"
                      Command="{Binding Passive.StartCommand}"
                      ToolTip="Listens on the adapter selected at the top of the window. Sends nothing at all - devices appear as they talk: ARP, BOOTP/DHCP, LLDP, PROFINET and EtherNet/IP." />
              <Button Content="Stop" Command="{Binding Passive.StopCommand}" />
              <CheckBox Content="Promiscuous" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsChecked="{Binding Passive.Promiscuous}"
                        ToolTip="Also hear frames addressed to other devices - on a switched network that is mostly multicast like LLDP. Some Wi-Fi adapters refuse it; untick if listening will not start." />
              <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                         MaxWidth="640" TextTrimming="CharacterEllipsis"
                         Text="{Binding Passive.Status}" ToolTip="{Binding Passive.Status}" />
            </WrapPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource FaultNotice}" Margin="10,0,10,8"
                    Visibility="{Binding Passive.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" TextWrapping="Wrap" Text="{Binding Passive.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Passive.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Passive.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="10,0,10,8" Padding="4">
              <DataGrid ItemsSource="{Binding Passive.Devices}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Extended"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                    <Style.Triggers>
                      <!-- Asking for an address and never seen holding one: the device a BOOTP server is for. -->
                      <DataTrigger Binding="{Binding IsWaitingForAddress}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="MAC" Width="140" Binding="{Binding Mac, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Vendor" Width="160" Binding="{Binding Vendor, Mode=OneWay}" />
                  <DataGridTextColumn Header="Address" Width="150" Binding="{Binding AddressText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Name" Width="170" Binding="{Binding NameText, Mode=OneWay}" />
                  <DataGridTextColumn Header="Heard by" Width="190" Binding="{Binding SourcesText, Mode=OneWay}" />
                  <DataGridTextColumn Header="VLAN" Width="50" Binding="{Binding Vlan, Mode=OneWay}" />
                  <DataGridTextColumn Header="Frames" Width="60" Binding="{Binding Frames, Mode=OneWay}" />
                  <DataGridTextColumn Header="Detail" Width="*" Binding="{Binding Detail, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>

        <!-- ================================ PROFINET ================================
             DCP: identify everything, then name, address or flash ONE device - confirmed, recorded,
             and read back. Needs Npcap: DCP is Ethernet, not IP. -->
        <TabItem Header="PROFINET" x:Name="ProfinetTab">
          <DockPanel Loaded="OnProfinetTabShown">

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,8,10,6" Padding="12,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="Npcap: " FontWeight="SemiBold" /><Run Text="{Binding Profinet.AvailabilityText, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                             Visibility="{Binding Profinet.Remediation, Converter={StaticResource NotNullToVisible}}"
                             Text="{Binding Profinet.Remediation}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Get Npcap" Click="OnGetNpcap" />
                  <Button Content="Check again" Command="{Binding Profinet.CheckAvailabilityCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,6">
              <Button Content="Identify" Style="{StaticResource PrimaryButton}"
                      Command="{Binding Profinet.IdentifyCommand}"
                      ToolTip="One DCP Identify All, from the adapter selected at the top of the window. Every PROFINET device on the segment answers with its name, type and address. A read - nothing is changed." />
              <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                         MaxWidth="700" TextTrimming="CharacterEllipsis"
                         Text="{Binding Profinet.Status}" ToolTip="{Binding Profinet.Status}" />
            </WrapPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource FaultNotice}" Margin="10,0,10,8"
                    Visibility="{Binding Profinet.ErrorMessage, Converter={StaticResource NotNullToVisible}}">
              <StackPanel>
                <TextBlock Style="{StaticResource FaultText}" TextWrapping="Wrap" Text="{Binding Profinet.ErrorMessage}" />
                <TextBlock Style="{StaticResource FaultText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Profinet.ErrorRemediation, Converter={StaticResource NotNullToVisible}}"
                           Text="{Binding Profinet.ErrorRemediation}" />
              </StackPanel>
            </Border>

            <!-- The selected device's edit card. Changes go to that one MAC only, after a confirmation. -->
            <Border DockPanel.Dock="Right" Width="330" Style="{StaticResource Card}" Margin="0,0,10,8" Padding="12,10">
              <StackPanel>
                <TextBlock Style="{StaticResource PanelHead}" Text="Selected device" />
                <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" FontFamily="{DynamicResource mono}"
                           Text="{Binding Profinet.Selected.Mac, Mode=OneWay, FallbackValue='Pick a device in the list.'}" />

                <TextBlock Text="Station name" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Profinet.NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                         ToolTip="Lowercase letters, digits, '-' and '.', as the controller's project names it." />
                <Button Content="Set name" HorizontalAlignment="Left" Command="{Binding Profinet.SetNameCommand}" />

                <TextBlock Text="Address" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                <TextBox Text="{Binding Profinet.NewIp, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}" Margin="0,2,0,4" />
                <TextBlock Text="Mask" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Profinet.NewMask, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}" Margin="0,2,0,4" />
                <TextBlock Text="Gateway (blank for none)" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding Profinet.NewGateway, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}" Margin="0,2,0,4" />
                <Button Content="Set address" HorizontalAlignment="Left" Command="{Binding Profinet.SetIpCommand}" />

                <CheckBox Content="Keep after a power cycle" Margin="0,10,0,0"
                          IsChecked="{Binding Profinet.Permanent}"
                          ToolTip="Off sets the value until the device's next power cycle - for a quick test on a bench." />

                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Flash LED" Command="{Binding Profinet.FlashCommand}"
                          ToolTip="Makes the device blink for a few seconds, so somebody at the panel can see which one it is. Stores nothing." />
                  <Button Content="Read again" Command="{Binding Profinet.ReadBackCommand}"
                          ToolTip="A DCP Get to this device: its name and address as it holds them now." />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="10,0,10,8" Padding="4">
              <DataGrid ItemsSource="{Binding Profinet.Devices}"
                        SelectedItem="{Binding Profinet.Selected}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AddressConflict}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource row-bad}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding HasName}" Value="False">
                        <Setter Property="Background" Value="{DynamicResource row-warn}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="MAC" Width="140" Binding="{Binding Mac, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Station name" Width="180" Binding="{Binding NameOfStation, Mode=OneWay}" />
                  <DataGridTextColumn Header="Type" Width="140" Binding="{Binding TypeOfStation, Mode=OneWay}" />
                  <DataGridTextColumn Header="Address" Width="120" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Mask" Width="120" Binding="{Binding Mask, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Gateway" Width="120" Binding="{Binding Gateway, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Set by" Width="70" Binding="{Binding AddressOrigin, Mode=OneWay}" />
                  <DataGridTextColumn Header="Vendor:device" Width="100" Binding="{Binding IdText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  <DataGridTextColumn Header="Role" Width="*" Binding="{Binding RoleText, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>

      </TabControl>
      </Border>
    </Grid>

  </DockPanel>
</Window>
