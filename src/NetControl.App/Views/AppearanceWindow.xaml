<Window x:Class="NetControl.App.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appearance"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource bg-0}"
        FontFamily="{DynamicResource font}"
        FontSize="{DynamicResource ui-font}"
        Foreground="{DynamicResource txt-0}">

  <!-- The counterpart to the DWG viewer's appearance dialog and the PDF app's settings modal,
       and deliberately the same shape: three independent axes, one control each, a one-line note
       under every choice saying what it is for, and a live preview.

       Live preview rather than an OK-then-look: the whole point of five themes is that the right
       one is obvious on sight and unguessable from a name. Cancel puts back whatever was running
       when the dialog opened, so trying all five costs nothing. -->

  <Grid Margin="18,16,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
    <ComboBox x:Name="ThemeBox" Grid.Row="0" Grid.Column="1"
              DisplayMemberPath="Label" SelectedValuePath="Id"
              SelectionChanged="OnChoiceChanged" />
    <TextBlock x:Name="ThemeNote" Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}"
               TextWrapping="Wrap" Margin="0,4,0,14" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
    <ComboBox x:Name="AccentBox" Grid.Row="2" Grid.Column="1"
              SelectedValuePath="Id" SelectionChanged="OnChoiceChanged">
      <!-- The swatch is the control's own preview: six colour names in a list say much less
           than six colours do. -->
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource line}" BorderThickness="1">
              <Border.Background>
                <SolidColorBrush Color="{Binding Rgb}" />
              </Border.Background>
            </Border>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" TextWrapping="Wrap"
               Margin="0,4,0,14"
               Text="Used for the armed control, the selected row and the field you are typing in." />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Density" Style="{StaticResource PanelHead}"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
    <ComboBox x:Name="DensityBox" Grid.Row="4" Grid.Column="1"
              DisplayMemberPath="Label" SelectedValuePath="Id"
              SelectionChanged="OnChoiceChanged" />
    <TextBlock x:Name="DensityNote" Grid.Row="5" Grid.Column="1" Style="{StaticResource Muted}"
               TextWrapping="Wrap" Margin="0,4,0,14" />

    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Muted}" TextWrapping="Wrap"
               Margin="0,0,0,14"
               Text="The DWG viewer and the redline PDF app share this design system, so a theme you pick here will look familiar in those." />

    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="OK" IsDefault="True" Click="OnAccept" Margin="0"
              Style="{StaticResource PrimaryButton}" />
    </StackPanel>

  </Grid>
</Window>
