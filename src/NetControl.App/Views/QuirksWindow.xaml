<Window x:Class="NetControl.App.Views.QuirksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device quirks"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- What this one device is known to do wrong. Ticked here by hand, or learned from a Set static
       that went a particular way; either way the change is one row in the record. Each line says
       what the tool does about it, including "informs only", because a checkbox that looks like it
       changes something and does not is worse than none. -->

  <StackPanel Margin="18,14,18,14">
    <TextBlock x:Name="DeviceLine" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"
               Text="Set static learns some of these by itself. Untick one that turned out to be a one-off." />

    <ItemsControl x:Name="Choices">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8">
            <StackPanel>
              <CheckBox IsChecked="{Binding IsChecked}" FontWeight="SemiBold" Content="{Binding Info.Label}" />
              <TextBlock Margin="22,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}"
                         Text="{Binding Info.Meaning}" />
              <TextBlock Margin="22,2,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}"
                         Text="{Binding Info.Effect}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80"
              Margin="0,0,8,0" Click="OnSave" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
