<Window x:Class="NetControl.App.Views.AdapterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetControl.App.ViewModels"
        Title="Adapter address"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <!-- This laptop's own adapter, not a device. Shown, checked, confirmed, read back; the settings
       before the first change are kept on this laptop for Restore. -->

  <StackPanel Margin="18,14,18,14">
    <TextBlock Style="{StaticResource PanelHead}" Text="{Binding AdapterTitle}" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0">
      <Run Text="Now: " /><Run Text="{Binding CurrentText, Mode=OneWay}" />
    </TextBlock>

    <!-- Restore: what it had before NetControl first changed it. -->
    <Border Style="{StaticResource WarningNotice}" Margin="0,8,0,0" Padding="8,5" BorderThickness="1"
            Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Forget" Margin="6,0,0,0" Command="{Binding ForgetSavedCommand}"
                ToolTip="Stop keeping these settings. The adapter is not changed." />
        <Button DockPanel.Dock="Right" Content="Restore" Margin="8,0,0,0" Command="{Binding RestoreCommand}"
                ToolTip="Puts the adapter back to these settings, after a confirmation that shows the netsh lines." />
        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
          <Run Text="Before NetControl changed it: " /><Run Text="{Binding SavedText, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,14,6" />
      <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                DisplayMemberPath="Name"
                ToolTip="The plan's own subnets, with the laptop at the host number on the right, then the profiles saved in this project." />
      <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,6">
        <TextBlock Text="Laptop at ." VerticalAlignment="Center" Style="{StaticResource Muted}" />
        <TextBox Width="44" Text="{Binding HostNumberText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="The laptop's host number on each plan subnet - e.g. 250 puts it at x.x.x.250. Kept in the project. A number a device is planned at is stepped down from." />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="Change" VerticalAlignment="Center" Margin="0,0,14,6" />
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                ItemsSource="{x:Static vm:AdapterIpModes.All}"
                SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="Label" />

      <TextBlock Grid.Row="2" Text="Address" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" IsEnabled="{Binding IsAddressMode}"
               Text="{Binding IpText, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="3" Text="Subnet mask" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" IsEnabled="{Binding IsAddressMode}"
               Text="{Binding MaskText, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="4" Text="Gateway" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" IsEnabled="{Binding IsAddressMode}"
               Text="{Binding GatewayText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Usually empty. A gateway here adds a default route; it is given a high metric so Wi-Fi keeps the internet." />
      <TextBlock Grid.Row="4" Grid.Column="2" Text="usually empty" Style="{StaticResource Muted}"
                 VerticalAlignment="Center" Margin="8,0,0,6" />

      <TextBlock Grid.Row="5" Text="DNS" VerticalAlignment="Center" Margin="0,0,14,6" />
      <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" IsEnabled="{Binding IsAddressMode}"
               Text="{Binding DnsText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Optional. Several separated by commas." />

      <TextBlock Grid.Row="6" Text="Save as" VerticalAlignment="Center" Margin="0,8,14,0" />
      <TextBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
               Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="A name for these settings, kept in the project so whoever opens it next has them." />
      <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,0">
        <Button Content="Save" Command="{Binding SaveProfileCommand}" />
        <Button Content="Delete" Margin="4,0,0,0" Command="{Binding DeleteProfileCommand}"
                ToolTip="Deletes the selected saved profile. The plan's subnets follow the plan and cannot be deleted." />
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource FaultNotice}" Margin="0,12,0,0" Padding="8,5" BorderThickness="1"
            Visibility="{Binding ProblemsText, Converter={StaticResource NotNullToVisible}}">
      <TextBlock Style="{StaticResource FaultText}" Text="{Binding ProblemsText}" />
    </Border>

    <Border Style="{StaticResource WarningNotice}" Margin="0,8,0,0" Padding="8,5" BorderThickness="1"
            Visibility="{Binding WarningsText, Converter={StaticResource NotNullToVisible}}">
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource warn}" Text="{Binding WarningsText}" />
    </Border>

    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,2" Text="What will run:" />
    <TextBlock Style="{StaticResource MonoText}" TextWrapping="Wrap" MinHeight="44"
               Foreground="{DynamicResource txt-2}" Text="{Binding CommandsText}" />

    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Status}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsBad}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource bad}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Apply..." Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="0,0,8,0"
              Command="{Binding ApplyCommand}"
              ToolTip="Shows the netsh lines and asks, then makes the change - with one administrator prompt if Windows needs it - and reads the adapter back." />
      <Button Content="Close" IsCancel="True" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
