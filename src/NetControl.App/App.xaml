<Application x:Class="NetControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetControl.App.Views">
  <Application.Resources>
    <ResourceDictionary>

      <!-- The chrome. Every colour, radius, font and height in it is a {DynamicResource} looked
           up in the token dictionary, which App.OnStartup installs ahead of this one and the
           appearance dialog replaces on every keystroke. Nothing else in the app may merge a
           dictionary at index 0 - see ThemeDictionary. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Appearance/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The four state colours are NOT here any more. They are tokens now (good, warn, bad and
           txt-2 for "we did not measure it"), because a green that works on white is invisible on
           the dark chrome - and because the same four have to hold in all five themes. ReadinessBrushes
           is where they are turned into brushes a converter can hand back. -->
      <views:ReadinessBrushConverter x:Key="ReadinessBrush" />
      <views:NullToVisibilityConverter x:Key="NotNullToVisible" />
      <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    </ResourceDictionary>
  </Application.Resources>
</Application>
