<Application x:Class="NetControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetControl.App.Views">
  <Application.Resources>

    <!-- One place for the colours, because the same four states appear in the interface bar and
         in the log and they have to agree. Green means measured and fine; grey means we did not
         measure it, which is never good news and must never read as green. -->
    <SolidColorBrush x:Key="ReadyBrush"   Color="#1B7F3B" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="BlockedBrush" Color="#B00020" />

    <SolidColorBrush x:Key="PanelBrush"         Color="#F4F4F5" />
    <SolidColorBrush x:Key="LineBrush"          Color="#D8D8DC" />
    <SolidColorBrush x:Key="MutedBrush"         Color="#5A5A60" />
    <SolidColorBrush x:Key="UnknownDeviceBrush" Color="#FFF5E6" />
    <SolidColorBrush x:Key="ServedBrush"        Color="#EAF6ED" />
    <SolidColorBrush x:Key="FaultBrush"         Color="#FDECEF" />
    <SolidColorBrush x:Key="WarningRowBrush"    Color="#FFF7E6" />

    <views:ReadinessBrushConverter x:Key="ReadinessBrush" />
    <views:NullToVisibilityConverter x:Key="NotNullToVisible" />
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

  </Application.Resources>
</Application>
